{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lectio.local/schemas/path-plan.schema.json",
  "title": "CanonicalPathPlan",
  "description": "Active minimal path-planner output after normalization. Concept slugs are code-owned and are not part of this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "lessons"],
  "properties": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_cover", "do_not_cover"],
      "properties": {
        "must_cover": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "do_not_cover": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "objective",
          "requires",
          "must_establish",
          "knowledge_type"
        ],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "requires": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "must_establish": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "knowledge_type": {
            "type": "string",
            "enum": ["procedural", "conceptual", "factual", "evaluative"]
          }
        }
      }
    }
  }
}
