  "sections": [
    {
      "id": "orient",
      "title": "Two Pots, One Difference",
      "blocks": [
        {
          "id": "observe-paragraph",
          "object": "prose",
          "intent": "explain",
          "position": 0,
          "content": {
            "paragraphs": [
              {
                "children": [
                  {
                    "type": "text",
                    "value": "Two pots are set up to be compared. They hold identical soil, they are watered by the same amount, and they stand in the same room at the same temperature. The only difference between them is "
                  },
                  {
                    "type": "strong",
                    "children": [
                      {
                        "type": "text",
                        "value": "where each pot sits"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "value": "."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "observe-figure",
          "object": "figure",
          "intent": "explain",
          "position": 1,
          "content": {
            "asset": {
              "kind": "image",
              "status": "ready",
              "src": "/seedlings.svg"
            },
            "alt_text": "A sunny windowsill seedling is green and leaning toward the window; a dark cupboard seedling is pale and has stopped growing.",
            "caption": [
              {
                "type": "text",
                "value": "The two seedlings are treated the same in every way except where they stand."
              }
            ]
          }
        },
        {
          "id": "observe-question",
          "object": "prose",
          "intent": "explain",
          "position": 2,
          "content": {
            "paragraphs": [
              {
                "children": [
                  {
                    "type": "text",
                    "value": "A plant that adds height and unfolds new leaves is doing something that costs energy. That gives this lesson its question:"
                  }
                ]
              },
              {
                "children": [
                  {
                    "type": "strong",
                    "children": [
                      {
                        "type": "text",
                        "value": "Where does the energy a plant uses to grow actually come from?"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "observe-known-heading",
          "object": "heading",
          "position": 3,
          "content": {
            "text": [
              {
                "type": "text",
                "value": "What you already know"
              }
            ],
            "level": 3
          }
        },
        {
          "id": "observe-known-list",
          "object": "list",
          "intent": "show-structure",
          "position": 4,
          "content": {
            "style": "unordered",
            "items": [
              {
                "text": [
                  {
                    "type": "text",
                    "value": "Plants are living things that need light and water to grow."
                  }
                ]
              },
              {
                "text": [
                  {
                    "type": "text",
                    "value": "Every living thing needs energy to stay alive."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "observe-answers-heading",
          "object": "heading",
          "position": 5,
          "content": {
            "text": [
              {
                "type": "text",
                "value": "Two possible answers"
              }
            ],
            "level": 3
          }
        },
        {
          "id": "observe-answers-paragraph",
          "object": "prose",
          "intent": "explain",
          "position": 6,
          "content": {
            "paragraphs": [
              {
                "children": [
                  {
                    "type": "text",
                    "value": "Where the growing energy comes from is exactly what people disagree about."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "observe-answers-compare",
          "object": "compare",
          "intent": "explain",
          "position": 7,
          "content": {
            "items": [
              {
                "label": [
                  {
                    "type": "text",
                    "value": "Answer A"
                  }
                ],
                "title": [
                  {
                    "type": "text",
                    "value": "From the soil"
                  }
                ],
                "body": [
                  {
                    "type": "text",
                    "value": "The energy is taken in together with the water the roots draw up."
                  }
                ]
              },
              {
                "label": [
                  {
                    "type": "text",
                    "value": "Answer B"
                  }
                ],
                "title": [
                  {
                    "type": "text",
                    "value": "From the light"
                  }
                ],
                "body": [
                  {
                    "type": "text",
                    "value": "The energy is captured from the light by the plant's leaves."
                  }
                ]
              }
            ]
          },
          "layout": {
            "placement": "spanning"
          }
        },
        {
          "id": "observe-prediction-paragraph",
          "object": "prose",
          "intent": "explain",
          "position": 8,
          "content": {
            "paragraphs": [
              {
                "children": [
                  {
                    "type": "text",
                    "value": "Neither answer is settled yet. Take the one you think is more likely and hold it as a "
                  },
                  {
                    "type": "strong",
                    "children": [
                      {
                        "type": "text",
                        "value": "prediction"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "value": ", not a fact. Evidence, not preference, is what settles a question like this."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "Q1",
          "object": "choices",
          "intent": "check-understanding",
          "position": 9,
          "content": {
            "stem": [
              {
                "type": "text",
                "value": "Where does the energy a plant uses to grow come from?"
              }
            ],
            "options": [
              {
                "letter": "A",
                "text": [
                  {
                    "type": "text",
                    "value": "The plant takes in its growing energy from the soil, together with the water."
                  }
                ]
              },
              {
                "letter": "B",
                "text": [
                  {
                    "type": "text",
                    "value": "The plant captures its growing energy from the light, using its leaves."
                  }
                ]
              }
            ]
          },
          "role": "predict"
        }
      ]
    },
    {
      "id": "explain",
      "title": "Where the Growing Energy Comes From",
      "blocks": [
        {
          "id": "explain-key-idea",
          "object": "aside",
          "intent": "emphasise",
          "position": 0,
          "content": {
            "body": [
              {
                "type": "text",
                "value": "The energy a plant grows on is captured from light, not taken in from the soil."
              }
            ],
            "label": [
              {
                "type": "text",
                "value": "Key idea"
              }
            ],
            "variant": "key_idea"
          },
          "layout": {
            "placement": "spanning"
          }
        },
        {
          "id": "explain-paragraph-one",
          "object": "prose",
          "intent": "explain",
          "position": 1,
          "content": {
            "paragraphs": [
              {
                "children": [
                  {
                    "type": "text",
                    "value": "The green parts of a plant — mostly its leaves — absorb "
                  },
                  {
                    "type": "strong",
                    "children": [
                      {
                        "type": "text",
                        "value": "light energy"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "value": ". The leaf uses that energy to make the plant's own "
                  },
                  {
                    "type": "strong",
                    "children": [
                      {
                        "type": "text",
                        "value": "food"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "value": ": a sugar built from water drawn up out of the soil and carbon dioxide taken in from the air."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "explain-equation",
          "object": "equation",
          "intent": "explain",
          "position": 2,
          "content": {
            "label": [
              {
                "type": "text",
                "value": "In one line"
              }
            ],
            "inputs": [
              [
                {
                  "type": "text",
                  "value": "water"
                }
              ],
              [
                {
                  "type": "text",
                  "value": "carbon dioxide (CO"
                },
                {
                  "type": "subscript",
                  "children": [
                    {
                      "type": "text",
                      "value": "2"
                    }
                  ]
                },
                {
                  "type": "text",
                  "value": ")"
                }
              ]
            ],
            "condition": [
              {
                "type": "text",
                "value": "light energy"
              }
            ],
            "outputs": [
              [
                {
                  "type": "text",
                  "value": "sugar (the plant's food)"
                }
              ]
            ]
          },
          "layout": {
            "placement": "spanning"
          }
        },
        {
          "id": "explain-paragraph-two",
          "object": "prose",
          "intent": "explain",
          "position": 3,
          "content": {
            "paragraphs": [
              {
                "children": [
                  {
                    "type": "text",
                    "value": "The energy stored inside that sugar is what the plant spends on building new leaves, stem and roots."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "explain-steps-heading",
          "object": "heading",
          "position": 4,
          "content": {
            "text": [
              {
                "type": "text",
                "value": "Follow the energy, step by step"
              }
            ],
            "level": 3
          }
        },
        {
          "id": "explain-steps",
          "object": "list",
          "intent": "show-structure",
          "position": 5,
          "content": {
            "style": "ordered",
            "items": [
              {
                "text": [
                  {
                    "type": "text",
                    "value": "Sunlight reaches the leaf."
                  }
                ]
              },
              {
                "text": [
                  {
                    "type": "text",
                    "value": "The leaf's green parts capture that light energy."
                  }
                ]
              },
              {
                "text": [
                  {
                    "type": "text",
                    "value": "The captured energy is used to build sugar from water and carbon dioxide. The energy is now stored inside food the plant has made for itself."
                  }
                ]
              },
              {
                "text": [
                  {
                    "type": "text",
                    "value": "The plant breaks some of that sugar down again and uses the released energy to build new leaves, stem and roots. That is growth."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "explain-misconception",
          "object": "aside",
          "intent": "define",
          "position": 6,
          "content": {
            "body": [
              {
                "type": "text",
                "value": "The energy enters the plant through the leaf, never through the soil. The only things arriving from the soil are water and dissolved minerals. Leaf area can be measured in m"
              },
              {
                "type": "superscript",
                "children": [
                  {
                    "type": "text",
                    "value": "2"
                  }
                ]
              },
              {
                "type": "text",
                "value": "."
              }
            ],
            "label": [
              {
                "type": "text",
                "value": "Notice two things"
              }
            ],
            "variant": "note"
          },
          "layout": {
            "placement": "spanning"
          }
        },
        {
          "id": "explain-soil-heading",
          "object": "heading",
          "position": 7,
          "content": {
            "text": [
              {
                "type": "text",
                "value": "So what is the soil for?"
              }
            ],
            "level": 3
          }
        },
        {
          "id": "explain-paragraph",
          "object": "prose",
          "intent": "explain",
          "position": 8,
          "content": {
            "paragraphs": [
              {
                "children": [
                  {
                    "type": "text",
                    "value": "Soil does a real job. It holds the plant firmly in place, and it holds water and dissolved minerals, which the roots take in and which then travel up to the leaves. Minerals are raw materials. They are not food, and they carry no usable energy."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "explain-table",
          "object": "table",
          "intent": "explain",
          "position": 9,
          "content": {
            "columns": [
              {
                "id": "column-1",
                "label": [
                  {
                    "type": "text",
                    "value": "What the plant takes in"
                  }
                ]
              },
              {
                "id": "column-2",
                "label": [
                  {
                    "type": "text",
                    "value": "Where from"
                  }
                ]
              },
              {
                "id": "column-3",
                "label": [
                  {
                    "type": "text",
                    "value": "Is it energy?"
                  }
                ]
              }
            ],
            "rows": [
              {
                "cells": {
                  "column-1": [
                    {
                      "type": "text",
                      "value": "Water"
                    }
                  ],
                  "column-2": [
                    {
                      "type": "text",
                      "value": "Soil, through the roots"
                    }
                  ],
                  "column-3": [
                    {
                      "type": "text",
                      "value": "No. A raw material for making sugar."
                    }
                  ]
                }
              },
              {
                "cells": {
                  "column-1": [
                    {
                      "type": "text",
                      "value": "Dissolved minerals"
                    }
                  ],
                  "column-2": [
                    {
                      "type": "text",
                      "value": "Soil, through the roots"
                    }
                  ],
                  "column-3": [
                    {
                      "type": "text",
                      "value": "No. Raw materials for building the plant's body."
                    }
                  ]
                }
              },
              {
                "cells": {
                  "column-1": [
                    {
                      "type": "text",
                      "value": "Light"
                    }
                  ],
                  "column-2": [
                    {
                      "type": "text",
                      "value": "Captured by the leaves"
                    }
                  ],
                  "column-3": [
                    {
                      "type": "text",
                      "value": "Yes. It ends up stored in sugar."
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "id": "explain-closing",
          "object": "prose",
          "intent": "explain",
          "position": 10,
          "content": {
            "paragraphs": [
              {
                "children": [
                  {
                    "type": "text",
                    "value": "So a plant standing in rich soil with plenty of water, but kept in the dark, cannot make its own food and cannot grow, however well watered it is."
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "contrast",
      "title": "Two Beliefs That Fail the Evidence",
      "blocks": [
        {
          "id": "contrast-belief",
          "object": "aside",
          "intent": "diagnose-misconception",
          "position": 0,
          "content": {
            "body": [],
            "label": [
              {
                "type": "text",
                "value": "Common belief 1"
              }
            ],
            "variant": "misconception",
            "belief": [
              {
                "type": "emphasis",
                "children": [
                  {
                    "type": "text",
                    "value": "The soil feeds the plant. A plant kept in the dark will keep growing as long as it is watered."
                  }
                ]
              }
            ],
            "evidence": [
              {
                "type": "text",
                "value": "Both pots held the same soil and got the same water. If the soil were supplying food and energy, the cupboard plant should have grown just as well. It stopped growing and turned pale."
              }
            ],
            "conclusion": [
              {
                "type": "text",
                "value": "Soil supplies only water and dissolved minerals. The plant's food is made in its own leaves, using light energy."
              }
            ],
            "aside": [
              {
                "type": "text",
                "value": "Why did the cupboard plant keep going for a while? It was living on food it had already made and stored. Once that store ran down, it stopped growing and lost its green colour."
              }
            ]
          },
          "layout": {
            "placement": "spanning"
          }
        },
        {
          "id": "contrast-belief-two",
          "object": "aside",
          "intent": "diagnose-misconception",
          "position": 1,
          "content": {
            "body": [],
            "label": [
              {
                "type": "text",
                "value": "Common belief 2"
              }
            ],
            "variant": "misconception",
            "belief": [
              {
                "type": "text",
                "value": "Light only keeps a plant warm or makes it look healthy. The energy for growth comes from the water and the minerals."
              }
            ],
            "evidence": [
              {
                "type": "text",
                "value": "Both pots stood in the same room at the same temperature. The cupboard was not cold, so the cupboard plant lacked no warmth. It still did not grow."
              }
            ],
            "conclusion": [
              {
                "type": "text",
                "value": "Light is not merely warmth. The leaves capture light energy and use it to make the plant's own food, and growth runs on the energy stored in that food."
              }
            ]
          },
          "layout": {
            "placement": "spanning"
          }
        }
      ]
    },
    {
      "id": "check",
      "title": "Which Observation Challenges the Soil Idea?",
      "blocks": [
        {
          "id": "check-quote",
          "object": "quote",
          "intent": "explain",
          "position": 0,
          "content": {
            "text": [
              {
                "type": "text",
                "value": "Plants get their food from the soil, so a plant in a dark room will keep growing as long as I water it."
              }
            ],
            "attribution": [
              {
                "type": "text",
                "value": "A student says"
              }
            ]
          },
          "layout": {
            "placement": "spanning"
          }
        },
        {
          "id": "check-paragraph",
          "object": "prose",
          "intent": "explain",
          "position": 1,
          "content": {
            "paragraphs": [
              {
                "children": [
                  {
                    "type": "text",
                    "value": "That claim is wrong. The strong move is not to repeat the explanation, but to point to "
                  },
                  {
                    "type": "strong",
                    "children": [
                      {
                        "type": "text",
                        "value": "evidence the claim cannot explain"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "value": "."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "Q2",
          "object": "choices",
          "intent": "check-understanding",
          "position": 2,
          "content": {
            "stem": [
              {
                "type": "text",
                "value": "Which observation would best challenge the student's idea?"
              }
            ],
            "options": [
              {
                "letter": "A",
                "text": [
                  {
                    "type": "text",
                    "value": "A watered plant kept in darkness becomes pale and stops growing larger."
                  }
                ]
              },
              {
                "letter": "B",
                "text": [
                  {
                    "type": "text",
                    "value": "A watered plant in darkness grows taller because it stretches toward the light."
                  }
                ]
              },
              {
                "letter": "C",
                "text": [
                  {
                    "type": "text",
                    "value": "A watered plant in darkness stays cool, which proves it lacks growth energy."
                  }
                ]
              },
              {
                "letter": "D",
                "text": [
                  {
                    "type": "text",
                    "value": "A watered plant in darkness grows well when it is given plant food."
                  }
                ]
              }
            ]
          },
          "role": "check"
        }
      ]
    }
  ],
  "answer_key": {
    "id": "answer-key-print-golden-shared-lesson-r1",
    "object": "answer-key",
    "intent": "answer-key",
    "position": 0,
    "content": {
      "groups": [
        {
          "entries": [
            {
              "question_id": "Q1",
              "answer": "Prediction (not marked)",
              "option_notes": {
                "soil": [
                  {
                    "type": "text",
                    "value": "The evidence will test this idea."
                  }
                ]
              },
              "not_marked": true
            },
            {
              "question_id": "Q2",
              "answer": "A",
              "feedback": [
                {
                  "type": "text",
                  "value": "That's the one. The soil idea says this plant should keep growing, because it still has soil and water. It does not, so the soil idea cannot be right."
                }
              ],
              "option_notes": {
                "b": [
                  {
                    "type": "text",
                    "value": "A plant growing taller in the dark would fit the soil idea, not challenge it."
                  }
                ],
                "c": [
                  {
                    "type": "text",
                    "value": "Temperature is not the issue. In the two-pot comparison both plants were equally warm."
                  }
                ],
                "d": [
                  {
                    "type": "text",
                    "value": "Growing well on plant food in the dark would support the soil idea, not challenge it."
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
