{
	"name": "@lectio/page",
	"description": "Print-native Lectio document engine — page objects, pedagogical intents, and A4 geometry",
	"author": "Richie Waweru",
	"license": "UNLICENSED",
	"private": false,
	"version": "0.1.0-experimental.0",
	"packageManager": "pnpm@10.14.0",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./LectioDocumentView.svelte": {
			"types": "./dist/render/LectioDocumentView.svelte.d.ts",
			"svelte": "./dist/render/LectioDocumentView.svelte",
			"default": "./dist/render/LectioDocumentView.svelte"
		},
		"./contract": {
			"types": "./dist/contract/document.d.ts",
			"default": "./dist/contract/document.js"
		},
		"./print/base-print.css": "./src/lib/print/base-print.css",
		"./contracts/*": "./contracts/*"
	},
	"files": [
		"dist",
		"contracts",
		"src/lib/print/base-print.css",
		"README.md",
		"!dist/**/*.test.*"
	],
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/richiewaweru/lectio-pageobject.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "playwright install chromium",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"package": "svelte-kit sync && svelte-package",
		"export-contracts": "tsx scripts/export-contracts.ts",
		"pdf:fixture": "tsx scripts/render-fixture-pdf.ts"
	},
	"keywords": [
		"education",
		"print",
		"page-objects",
		"lesson-document",
		"svelte"
	],
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/katex": "^0.16.8",
		"@types/node": "^24.12.2",
		"jsdom": "^26.1.0",
		"playwright": "^1.54.2",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.2.4",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.2",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"esm-env": "^1.2.2",
		"isomorphic-dompurify": "2.26.0",
		"katex": "^0.16.45",
		"marked": "^18.0.3"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	}
}
