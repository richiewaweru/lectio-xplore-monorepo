{
	"name": "@lectio/learn",
	"description": "Web-native Learn component library for pedagogically-structured lesson content",
	"author": "Richie Waweru",
	"license": "UNLICENSED",
	"private": true,
	"version": "0.7.0",
	"packageManager": "pnpm@10.14.0",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./theme.css": {
			"default": "./dist/theme.css"
		},
		"./contracts/*": "./contracts/*",
		"./generated/*": "./generated/*",
		"./components/*": "./dist/components/*.js"
	},
	"files": [
		"dist",
		"contracts",
		"generated",
		"README.md",
		"CHANGELOG.md",
		"!dist/**/*.test.*"
	],
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/richiewaweru/lectio.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "(svelte-kit sync || echo '') && pnpm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"package": "svelte-kit sync && svelte-package",
		"export-contracts": "tsx scripts/export-contracts.ts && tsx scripts/generate-python-types.ts",
		"prepublishOnly": "npm run package && npm run export-contracts",
		"version": "git add -A",
		"postversion": "git push && git push --tags"
	},
	"keywords": [
		"education",
		"edtech",
		"component-library",
		"lesson-content",
		"svelte",
		"learn"
	],
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/katex": "^0.16.8",
		"@types/node": "^24.12.2",
		"@types/qrcode": "^1.5.6",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"jsdom": "^26.1.0",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.8",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.4",
		"ts-json-schema-generator": "^2.9.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.2",
		"vitest": "^3.2.4",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"esm-env": "^1.2.2",
		"isomorphic-dompurify": "2.26.0",
		"katex": "^0.16.45",
		"lucide-svelte": "^0.577.0",
		"marked": "^18.0.3",
		"qrcode": "^1.5.4"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	}
}
