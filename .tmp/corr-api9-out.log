Y INSTRUCTIONS\\nCapability: choice.\\r\\n\\r\\nAuthor a complete activity envelope: student-facing prompt, choice config, and feedback.\\r\\n\\r\\n- Write the prompt as a clear question the learner reads directly. The planning brief is context only \u2014 do not copy it verbatim.\\r\\n- Provide feedback.correct and feedback.incorrect messages tied to the question and distractors.\\r\\n- Put options and the correct option id in config.\\r\\n\\r\\n- Use at least two options with unique stable ids.\\r\\n- Exactly one option is correct.\\r\\n- Distractors must be plausible and tied to a stateable misconception.\\r\\n- Do not use this for questions with several defensible answers.\\n\\n## AUTHORING DEFINITION\\n{\\n  \"assessment\": {\\n    \"default\": \"automatic_required\",\\n    \"supported\": [\\n      \"automatic_required\"\\n    ],\\n    \"teacher_review_permitted\": false\\n  },\\n  \"capability_id\": \"choice\",\\n  \"converter_ref\": \"learn.choice.approved_item_converter\",\\n  \"definition_hash\": \"9c9eca46dacb6c6603192a541ee7c019236a8ab713137ae9027d3e3557c1c7eb\",\\n  \"instructions\": \"Capability: choice.\\\\r\\\\n\\\\r\\\\nAuthor a complete activity envelope: student-facing prompt, choice config, and feedback.\\\\r\\\\n\\\\r\\\\n- Write the prompt as a clear question the learner reads directly. The planning brief is context only \\\\u2014 do not copy it verbatim.\\\\r\\\\n- Provide feedback.correct and feedback.incorrect messages tied to the question and distractors.\\\\r\\\\n- Put options and the correct option id in config.\\\\r\\\\n\\\\r\\\\n- Use at least two options with unique stable ids.\\\\r\\\\n- Exactly one option is correct.\\\\r\\\\n- Distractors must be plausible and tied to a stateable misconception.\\\\r\\\\n- Do not use this for questions with several defensible answers.\",\\n  \"knowledge\": {\\n    \"default\": \"supplied_preferred\",\\n    \"supported\": [\\n      \"supplied_only\",\\n      \"supplied_preferred\",\\n      \"objective_development\"\\n    ]\\n  },\\n  \"modes\": [\\n    \"generate\",\\n    \"convert-approved\"\\n  ],\\n  \"native_path\": \"learn\",\\n  \"payload_schema\": {\\n    \"additionalProperties\": true,\\n    \"properties\": {\\n      \"config\": {\\n        \"$id\": \"learn/choice/config.v1\",\\n        \"additionalProperties\": false,\\n        \"properties\": {\\n          \"correct_option_id\": {\\n            \"minLength\": 1,\\n            \"type\": \"string\"\\n          },\\n          \"options\": {\\n            \"items\": {\\n              \"additionalProperties\": false,\\n              \"properties\": {\\n                \"explanation\": {\\n                  \"type\": \"string\"\\n                },\\n                \"id\": {\\n                  \"minLength\": 1,\\n                  \"type\": \"string\"\\n                },\\n                \"text\": {\\n                  \"minLength\": 1,\\n                  \"type\": \"string\"\\n                }\\n              },\\n              \"required\": [\\n                \"id\",\\n                \"text\"\\n              ],\\n              \"type\": \"object\"\\n            },\\n            \"minItems\": 2,\\n            \"type\": \"array\",\\n            \"uniqueItems\": true\\n          },\\n          \"presentation\": {\\n            \"enum\": [\\n              \"text\",\\n              \"image\"\\n            ]\\n          }\\n        },\\n        \"required\": [\\n          \"options\",\\n          \"correct_option_id\"\\n        ],\\n        \"type\": \"object\"\\n      },\\n      \"feedback\": {\\n        \"additionalProperties\": false,\\n        \"properties\": {\\n          \"correct\": {\\n            \"type\": \"string\"\\n          },\\n          \"incorrect\": {\\n            \"type\": \"string\"\\n          },\\n          \"partial\": {\\n            \"type\": \"string\"\\n          }\\n        },\\n        \"required\": [\\n          \"correct\",\\n          \"incorrect\"\\n        ],\\n        \"type\": \"object\"\\n      },\\n      \"prompt\": {\\n        \"minLength\": 1,\\n        \"type\": \"string\"\\n      }\\n    },\\n    \"required\": [\\n      \"prompt\",\\n      \"config\",\\n      \"feedback\"\\n    ],\\n    \"type\": \"object\"\\n  },\\n  \"required_inputs\": [\\n    \"teaching_plan_block\",\\n    \"learn_selection_decision\",\\n    \"lesson_context\",\\n    \"allowed_facts\",\\n    \"terminology\",\\n    \"learner_action\",\\n    \"approved_items_when_converting\"\\n  ],\\n  \"validator_refs\": [\\n    \"learn.payload_schema\",\\n    \"learn.evaluateChoice\"\\n  ]\\n}\\n\\n## SCOPED REQUEST\\n{\\n  \"inputs\": {\\n    \"allowed_facts\": [\\n      \"plants have roots, stems and leaves\",\\n      \"living things need food to grow\",\\n      \"Plants are living things that can produce their own food\",\\n      \"Plants are called producers\",\\n      \"Use one concrete classroom example.\",\\n      \"Explain that plants make their own food (are producers)\",\\n      \"Identify leaves as the site of photosynthesis and chlorophyll as the light-capturing substance\",\\n      \"Describe photosynthesis as using light, carbon dioxide, and water to produce food and oxygen\",\\n      \"Explain why light is essential for photosynthesis\"\\n    ],\\n    \"approved_items_when_converting\": [],\\n    \"learn_selection_decision\": {\\n      \"capability_id\": \"choice\",\\n      \"lane\": \"interaction\",\\n      \"support_level\": null\\n    },\\n    \"learner_action\": \"select-one\",\\n    \"lesson_context\": {\\n      \"input_availability\": \"supplied_statements\",\\n      \"objective\": \"Recognize that plants are producers that make their own food\",\\n      \"subject\": \"Science\",\\n      \"teaching_plan_revision\": 1,\\n      \"title\": \"The lesson opens on the classroom plant on the windowsill beside the cup of water and asks learners to commit to a guess about where its food comes from, so a personal wrong model is on the table. The explanation then fixes the category term \\\\u2014 the plant is a producer, a living thing that makes its own food \\\\u2014 and separates what the plant takes in through its roots from what it makes. The contrast section puts the producer idea against the soil-as-food and water-as-food readings on the same plant so the boundary is visible, and the close checks whether the learner now recognizes the plant, not the soil or the water, as the maker of the food.\"\\n    },\\n    \"teaching_plan_block\": {\\n      \"action\": \"select-one\",\\n      \"block_id\": \"contrast-b1\",\\n      \"brief\": \"Take the windowsill plant and put the soil-as-food reading beside the target: one learner says the plant\\'s food is the soil, pulled up through the roots; the producer idea says the plant makes its own food and only draws materials from the soil. Show why the soil reading cannot stand, since the plant still makes food inside itself and the soil is only one of its intakes. Do not repeat the earlier intake-versus-made distinction in full, and do not slide into the water-as-food reading here.\",\\n      \"evidence\": \"The slot\\'s typical intents all treat both sides as legitimate or as a slip; M1 is a held belief that must be surfaced and shut down, so an atypical intent is required and the slot purpose still matches exactly.\",\\n      \"intent\": \"diagnose-misconception\",\\n      \"section_id\": \"contrast\"\\n    },\\n    \"terminology\": []\\n  },\\n  \"mode\": \"generate\",\\n  \"resolved_policy\": {\\n    \"assessment_policy_source\": \"package:1.0.0\",\\n    \"definition_hash\": \"9c9eca46dacb6c6603192a541ee7c019236a8ab713137ae9027d3e3557c1c7eb\",\\n    \"definition_version\": \"2.0.0\",\\n    \"effective_assessment_policy\": \"automatic_required\",\\n    \"effective_knowledge_policy\": \"supplied_preferred\",\\n    \"executed_evaluation_mode\": \"accepted-answers\",\\n    \"executed_knowledge_mode\": \"supplied_facts\",\\n    \"fallback_reason\": null,\\n    \"input_availability\": \"supplied_statements\",\\n    \"input_revision\": null,\\n    \"knowledge_policy_source\": \"package:1.0.0\",\\n    \"policy_version\": \"1.0.0\",\\n    \"requested_assessment_policy\": null,\\n    \"requested_knowledge_policy\": null,\\n    \"teacher_review_permitted\": false\\n  },\\n  \"scoped_request\": {\\n    \"action\": \"select-one\",\\n    \"allowed_facts\": [\\n      \"plants have roots, stems and leaves\",\\n      \"living things need food to grow\",\\n      \"Plants are living things that can produce their own food\",\\n      \"Plants are called producers\",\\n      \"Use one concrete classroom example.\",\\n      \"Explain that plants make their own food (are producers)\",\\n      \"Identify leaves as the site of photosynthesis and chlorophyll as the light-capturing substance\",\\n      \"Describe photosynthesis as using light, carbon dioxide, and water to produce food and oxygen\",\\n      \"Explain why light is essential for photosynthesis\"\\n    ],\\n    \"authoring_definition\": {\\n      \"assessment\": {\\n        \"default\": \"automatic_required\",\\n        \"supported\": [\\n          \"automatic_required\"\\n        ],\\n        \"teacher_review_permitted\": false\\n      },\\n      \"asset_requirements\": null,\\n      \"capability_id\": \"choice\",\\n      \"capacity\": {\\n        \"optionMaxWords\": 20,\\n        \"optionsMax\": 5,\\n        \"optionsMin\": 2,\\n        \"stemMaxWords\": 40\\n      },\\n      \"config_schema\": {\\n        \"$id\": \"learn/choice/config.v1\",\\n        \"additionalProperties\": false,\\n        \"properties\": {\\n          \"correct_option_id\": {\\n            \"minLength\": 1,\\n            \"type\": \"string\"\\n          },\\n          \"options\": {\\n            \"items\": {\\n              \"additionalProperties\": false,\\n              \"properties\": {\\n                \"explanation\": {\\n                  \"type\": \"string\"\\n                },\\n                \"id\": {\\n                  \"minLength\": 1,\\n                  \"type\": \"string\"\\n                },\\n                \"text\": {\\n                  \"minLength\": 1,\\n                  \"type\": \"string\"\\n                }\\n              },\\n              \"required\": [\\n                \"id\",\\n                \"text\"\\n              ],\\n              \"type\": \"object\"\\n            },\\n            \"minItems\": 2,\\n            \"type\": \"array\",\\n            \"uniqueItems\": true\\n          },\\n          \"presentation\": {\\n            \"enum\": [\\n              \"text\",\\n              \"image\"\\n            ]\\n          }\\n        },\\n        \"required\": [\\n          \"options\",\\n          \"correct_option_id\"\\n        ],\\n        \"type\": \"object\"\\n      },\\n      \"converter_ref\": \"learn.choice.approved_item_converter\",\\n      \"definition_hash\": \"9c9eca46dacb6c6603192a541ee7c019236a8ab713137ae9027d3e3557c1c7eb\",\\n      \"definition_version\": \"2.0.0\",\\n      \"examples\": [\\n        {\\n          \"correct_option_id\": \"air\",\\n          \"options\": [\\n            {\\n              \"explanation\": \"Mass is not drawn from soil.\",\\n              \"id\": \"soil\",\\n              \"text\": \"From the soil\"\\n            },\\n            {\\n              \"id\": \"air\",\\n              \"text\": \"From carbon dioxide in the air\"\\n            },\\n            {\\n              \"explanation\": \"Light supplies energy, not mass.\",\\n              \"id\": \"light\",\\n              \"text\": \"From sunlight alone\"\\n            }\\n          ]\\n        }\\n      ],\\n      \"field_guidance\": {\\n        \"config.correct_option_id\": \"Must equal the id of exactly one declared option.\",\\n        \"config.options\": \"Stable ids, parallel grammatical form. Give each wrong option an explanation naming the misconception it reveals.\",\\n        \"config.presentation\": \"\\'image\\' renders options as pic