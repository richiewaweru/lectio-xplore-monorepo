			v3Studio.stage = 'fill';
			connectChunkedStage2Stream(resolved.generation_id);

			return;
		}

		if ($.strict_equals(resolved.stage, 'blueprint_ready')) {
			disconnectActiveChunkedStream();
			v3Studio.stage = 'fill';
			connectGenerationStream(resolved.generation_id);

			try {
				const preview = (await $.track_reactivity_loss(getV3GenerationBlueprint(resolved.generation_id)))();

				v3Studio.blueprint = preview;

				if ($.strict_equals(v3Studio.canvas.length, 0)) {
					v3Studio.canvas = buildCanvasSkeleton(preview);
				}
			} catch {
				// Ignore preview recovery failures; stream and document hydration continue.
			}

			return;
		}

		if ($.strict_equals(resolved.stage, 'complete') || $.strict_equals(resolved.stage, 'completed')) {
			disconnectActiveChunkedStream();
			v3Studio.stage = 'edit';

			try {
				const preview = (await $.track_reactivity_loss(getV3GenerationBlueprint(resolved.generation_id)))();

				v3Studio.blueprint = preview;
			} catch {
				// Ignore missing preview and continue with persisted document hydration.
			}

			if (hydrateComplete) {
				(await $.track_reactivity_loss(hydrateFromDocument(resolved.generation_id)))();
			}
		}
	}

	async function navigateToReadyViewer(generationId) {
		if ($.strict_equals(readyNavigationGenerationId, generationId)) return;

		readyNavigationGenerationId = generationId;
		stopGenerationPolling();
		disconnectActiveChunkedStream();
		v3Studio.streamCancel?.();
		v3Studio.streamCancel = null;
		(await $.track_reactivity_loss(goto(`/studio/generations/${encodeURIComponent(generationId)}`)))();
	}

	function stateFromPlanAndStatus(plan, status) {
		const legacyStatus = status;

		return {
			generation_id: status.generation_id,
			pack_id: status.pack_id ?? plan.pack_id,
			stage: status.stage,
			structural_plan: legacyStatus.structural_plan ?? plan.structural_plan,
			section_briefs: legacyStatus.section_briefs ?? {},
			failed_sections: status.failed_sections,
			blueprint_id: status.blueprint_id,
			execution_started: status.execution_started,
			next_action: status.next_action,
			display_title: legacyStatus.display_title ?? plan.display_title,
			error: status.error,
			error_type: status.error_type,
			inferred_lesson_mode: plan.inferred_lesson_mode,
			lesson_mode_confidence: plan.lesson_mode_confidence,
			variants: plan.variants,
			variant_generation_ids: status.variant_generation_ids ?? plan.variant_generation_ids
		};
	}

	function mergeChunkedStatus(status) {
		const current = v3Studio.chunkedState;

		if (!current || $.strict_equals(current.generation_id, status.generation_id, false)) return null;

		return {
			...current,
			pack_id: status.pack_id ?? current.pack_id,
			stage: status.stage,
			failed_sections: status.failed_sections,
			blueprint_id: status.blueprint_id,
			execution_started: status.execution_started,
			next_action: status.next_action,
			error: status.error,
			error_type: status.error_type
		};
	}

	async function resumeChunkedFromQuery() {
		if (!browser) return;

		const generationId = new URL(window.location.href).searchParams.get('generation_id');

		if (!generationId) return;

		v3Studio.error = null;

		try {
			const [plan, status] = (await $.track_reactivity_loss(Promise.all([
				getChunkedPlan(generationId),
				getChunkedPlanStatus(generationId)
			])))();

			const state = stateFromPlanAndStatus(plan, status);

			v3Studio.chunkedState = state;
			v3Studio.generationId = generationId;

			const hydrated = (await $.track_reactivity_loss(hydrateFromDocument(generationId)))();

			if (hydrated) {
				hydratedDocumentGenerationId = generationId;
				lastDocumentVersion = status.doc_version;
			}

			(await $.track_reactivity_loss(applyChunkedState(state, { resume: true, hydrateComplete: false, pollImmediately: false })))();
		} catch {
			resetV3Studio();
			v3Studio.error = 'Could not resume that chunked session. Start a new lesson plan.';
		}
	}

	function friendly(err) {
		if (isApiError(err)) return err.detail;
		if (err instanceof Error) return err.message;

		return 'Something went wrong. Try again.';
	}

	function progressStageFromDocument(document) {
		const progress = document.progress;

		if ($.strict_equals(typeof progress, 'object', false) || $.strict_equals(progress, null)) return null;

		const stage = progress.stage;

		return $.strict_equals(typeof stage, 'string') ? stage : null;
	}

	function isTerminalProgressStage(stage) {
		return $.strict_equals(stage, 'completed') || $.strict_equals(stage, 'failed');
	}

	function shouldPollForChunkedState(state) {
		if ($.strict_equals(state.stage, 'awaiting_review') || $.strict_equals(state.stage, 'plan_ready') || $.strict_equals(state.stage, 'awaiting_teaching_approval') || $.strict_equals(state.stage, 'assembly_blocked') || $.strict_equals(state.stage, 'stage2_error') || $.strict_equals(state.stage, 'complete') || $.strict_equals(state.stage, 'failed_recoverable') || $.strict_equals(state.stage, 'failed_terminal') || $.strict_equals(state.stage, 'rejected_by_teacher')) {
			return false;
		}

		if ($.strict_equals(state.stage, 'completed')) return false;
		if ($.strict_equals(state.next_action, 'done')) return false;
		if (state.execution_started) return true;

		// Native whole-lesson: forms/writers run server-side after teacher approval; the
		// chunked stage stays in execution phases until the document is persisted, so keep polling.
		if ($.strict_equals(state.stage, 'queued') || $.strict_equals(state.stage, 'planning_forms') || $.strict_equals(state.stage, 'writing_sections') || $.strict_equals(state.stage, 'writing_blocks') || $.strict_equals(state.stage, 'assembling')) {
			return true;
		}

		if ($.strict_equals(state.stage, 'ready')) return false;
		if (['stage2_running', 'stage2_complete', 'blueprint_ready'].includes(state.stage)) return true;

		return $.strict_equals(state.next_action, 'wait_for_stage2') || $.strict_equals(state.next_action, 'generation_running');
	}

	function stopGenerationPolling() {
		generationPoller.stop();
		documentPollGenerationId = null;
		lastDocumentVersion = null;
		hydratedDocumentGenerationId = null;
	}

	async function pollGenerationStatus(generationId) {
		if (!browser || documentPollInFlight) return;

		documentPollInFlight = true;

		try {
			const status = (await $.track_reactivity_loss(getChunkedPlanStatus(generationId)))();
			const merged = mergeChunkedStatus(status);

			if (merged) {
				(await $.track_reactivity_loss(applyChunkedState(merged, { hydrateComplete: false })))();
			}

			const ready = $.strict_equals(status.stage, 'ready');

			if (!ready) {
				const versionChanged = $.strict_equals(typeof status.doc_version, 'string') && $.strict_equals(status.doc_version, lastDocumentVersion, false);

				if ($.strict_equals(hydratedDocumentGenerationId, generationId, false) || versionChanged) {
					const hydrated = (await $.track_reactivity_loss(hydrateFromDocument(generationId)))();

					if (hydrated) {
						hydratedDocumentGenerationId = generationId;
						lastDocumentVersion = status.doc_version;
					}
				}
			}

			if ($.strict_equals(status.stage, 'complete') || $.strict_equals(status.stage, 'failed_recoverable') || $.strict_equals(status.stage, 'failed_terminal') || $.strict_equals(status.next_action, 'done') || ready) {
				stopGenerationPolling();
			}
		} catch {
			// Keep the current UI state if status polling fails.
		} finally {
			documentPollInFlight = false;
		}
	}

	async function handleNativeRetry() {
		const generationId = v3Studio.generationId;
		const action = nativeRetryAction(v3Studio.chunkedState);

		if (!generationId || !action || $.get(recoveryBusy)) return;

		$.set(recoveryBusy, true);
		v3Studio.error = null;

		try {
			if ($.strict_equals(action, 'retry_visuals')) {
				(await $.track_reactivity_loss(retryNativeVisuals(generationId)))();
			} else {
				(await $.track_reactivity_loss(retryNativeGeneration(generationId)))();
			}

			const status = (await $.track_reactivity_loss(getChunkedPlanStatus(generationId)))();
			const merged = mergeChunkedStatus(status);

			if (merged) (await $.track_reactivity_loss(applyChunkedState(merged)))();

			startGenerationPolling(generationId);
		} catch(err) {
			v3Studio.error = friendly(err);
		} finally {
			$.set(recoveryBusy, false);
		}
	}

	function nativeRetryAction(state) {
		if (!state) return null;

		// A restart can leave a ready document with an active visual callback
		// error. The backend exposes that checkpoint as retryable visual quality;
		// keep the visible repair action wired to the visuals-only endpoint.
		if ($.strict_equals(state.stage, 'ready') && state.visual_quality && !Array.isArray(state.visual_quality) && state.visual_quality.retryable) {
			return 'retry_visuals';
		}

		if ($.strict_equals(state.stage, 'awaiting_visuals')) {
			return $.strict_equals(state.next_action, 'retry_visuals') ? 'retry_visuals' : null;
		}

		if ($.strict_equals(state.stage, 'failed_recoverable', false)) return null;

		switch (state.next_action) {
			case 'retry_items':

			case 'retry_teaching':

			case 'retry_native':

			case 'retry_visuals':
				return state.next_action;

			default:
				return null;
		}
	}

	function nativeRetryLabel(action) {
		switch (action) {
			case 'retry_items':
				return 'Retry lesson items';

			case 'retry_teaching':
				return 'Retry teaching plan';

			case 'retry_native':
				return 'Retry generation';

			case 'retry_visuals':
				return 'Retry visuals';

			default:
				return null;
		}
	}

	function startGenerationPolling(generationId, { immediate = true } = {}) {
		if ($.strict_equals(documentPollGenerationId, generationId) && generationPoller.isRunning()) return;

		stopGenerationPolling();
		documentPollGenerationId = generationId;
		generationPoller.start({ immediate });
	}

	async function hydrateFromDocument(generationId) {
		try {
			const document = (await $.track_reactivity_loss(fetchV3Document(generationId)))();
			const progressStage = progressStageFromDocument(document);

			const pack = coerceV3DocumentToPack(generationId, document, {
				templateId: v3Studio.blueprint?.template_id ?? 'guided-concept-path'
			});

			if (!pack) {
				if ($.strict_equals(progressStage, 'failed') || $.strict_equals(progressStage, 'completed')) {
					stopGenerationPolling();
					v3Studio.streamCancel?.();
					v3Studio.streamCancel = null;
					v3Studio.stage = 'skeleton';

					v3Studio.error = $.strict_equals(progressStage, 'completed')
						? 'Generation completed, but its resource snapshot was not saved.'
						: 'Generation failed before a resource snapshot was saved.';
				}

				return false;
			}

			v3Studio.draftPack = pack;
			v3Studio.activePack = pack;

			if ($.strict_equals(pack.status, 'final_ready') || $.strict_equals(pack.status, 'final_with_warnings')) {
				v3Studio.finalPack = pack;
			}

			v3Studio.bookletStatus = pack.status;
			v3Studio.bookletIssues = pack.booklet_issues;
			paintCanvasFromPack(pack);

			if ($.strict_equals(progressStage, 'failed')) {
				v3Studio.coherenceHint = null;
				v3Studio.error = 'Generation failed before the resource was finalised.';
				stopGenerationPolling();
				v3Studio.streamCancel?.();
				v3Studio.streamCancel = null;

				if (pack.sections.length > 0) {
					v3Studio.stage = 'edit';
				}
			} else if ($.strict_equals(progressStage, 'completed')) {
				v3Studio.coherenceHint = null;
				stopGenerationPolling();
				v3Studio.streamCancel?.();
				v3Studio.streamCancel = null;
				v3Studio.stage = 'edit';
			} else if (progressStage && !isTerminalProgressStage(progressStage)) {
				v3Studio.stage = 'fill';
			} else if ($.strict_equals(pack.status, 'streaming_preview', false)) {
				v3Studio.coherenceHint = null;
				v3Studio.stage = 'edit';
			}

			return true;
		} catch {
			return false;
		}
	}

	async function handleVisualRegenerated() {
		if (v3Studio.generationId) {
			(await $.track_reactivity_loss(hydrateFromDocument(v3Studio.generationId)))();
		}
	}

	async function refreshChunkedStatus(generationId) {
		try {
			const status = (await $.track_reactivity_loss(getChunkedPlanStatus(generationId)))();
			const state = mergeChunkedStatus(status);

			if (state) (await $.track_reactivity_loss(applyChunkedState(state, { hydrateComplete: false })))();
		} catch {
			// Keep current UI state if status refresh fails.
		}
	}

	function connectChunkedStage2Stream(generationId) {
		disconnectActiveChunkedStream();

		disconnectChunkedStream = connectV3ChunkedStream(generationId, {
			onSectionStart(sectionId) {
				$.set(stage2Progress, { ...$.get(stage2Progress), active: sectionId }, true);
				v3Studio.chunkedSectionStatus = { ...v3Studio.chunkedSectionStatus, [sectionId]: 'running' };
				v3Studio.canvas = patchCanvasSection(v3Studio.canvas, sectionId, (section) => ({ ...section, sectionStatus: 'running' }));
			},

			onSectionDone(sectionId, brief) {
				$.set(
					stage2Progress,
					{
						completed: Array.from(new Set([...$.get(stage2Progress).completed, sectionId])),
						failed: $.get(stage2Progress).failed.filter((id) => $.strict_equals(id, sectionId, false)),
						active: null
					},
					true
				);

				v3Studio.chunkedSectionStatus = { ...v3Studio.chunkedSectionStatus, [sectionId]: 'done' };
				v3Studio.chunkedSectionErrors = { ...v3Studio.chunkedSectionErrors, [sectionId]: [] };

				v3Studio.canvas = patchCanvasSection(v3Studio.canvas, sectionId, (section) => ({
					...section,
					sectionStatus: 'complete',
					stage2Preview: brief
						? {
							componentIntents: brief.components.map((component) => ({
								componentId: component.component_id,
								intent: component.content_intent
							})),
							questionPrompts: brief.question_prompts,
							visualSubject: brief.visual_subject
						}
						: section.stage2Preview
				}));
			},

			onSectionRetry(sectionId) {
				$.set(stage2Progress, { ...$.get(stage2Progress), active: sectionId }, true);
				v3Studio.chunkedSectionStatus = { ...v3Studio.chunkedSectionStatus, [sectionId]: 'retrying' };
				v3Studio.canvas = patchCanvasSection(v3Studio.canvas, sectionId, (section) => ({ ...section, sectionStatus: 'running' }));
			},

			onSectionFailed(sectionId, errors) {
				console.warn(...$.log_if_contains_state('warn', '[chunked] section failed', sectionId, errors));

				$.set(
					stage2Progress,
					{
						completed: $.get(stage2Progress).completed.filter((id) => $.strict_equals(id, sectionId, false)),
						failed: Array.from(new Set([...$.get(stage2Progress).failed, sectionId])),
						active: null
					},
					true
				);

				v3Studio.chunkedSectionStatus = { ...v3Studio.chunkedSectionStatus, [sectionId]: 'failed' };
				v3Studio.chunkedSectionErrors = { ...v3Studio.chunkedSectionErrors, [sectionId]: errors };
				v3Studio.canvas = patchCanvasSection(v3Studio.canvas, sectionId, (section) => ({ ...section, sectionStatus: 'failed' }));
			},

			onStage2Complete(failedSections) {
				if (v3Studio.chunkedState) {
					v3Studio.chunkedState = {
						...v3Studio.chunkedState,
						stage: 'stage2_complete',
						failed_sections: failedSections
					};
				}

				$.set(
					stage2Progress,
					{
						completed: $.get(stage2Progress).completed,
						failed: failedSections,
						active: null
					},
					true
				);

				disconnectActiveChunkedStream();
				connectGenerationStream(generationId);
			},

			onAssemblyBlocked(failedSections) {
				console.warn(...$.log_if_contains_state('warn', '[chunked] assembly blocked', failedSections));

				if (v3Studio.chunkedState) {
					v3Studio.chunkedState = {
						...v3Studio.chunkedState,
						stage: 'assembly_blocked',
						failed_sections: failedSections
					};
				}

				$.set(
					stage2Progress,
					{
						completed: $.get(stage2Progress).completed,
						failed: failedSections,
						active: null
					},
					true
				);

				if (v3Studio.chunkedState?.structural_plan) {
					v3Studio.canvas = buildStructuralPlanCanvas(v3Studio.chunkedState.structural_plan);
				}

				v3Studio.stage = 'skeleton';
				disconnectActiveChunkedStream();
			},

			onError(msg) {
				console.error(...$.log_if_contains_state('error', '[chunked stream error]', msg));
			}
		});
	}

	function connectGenerationStream(generationId) {
		disconnectActiveChunkedStream();
		v3Studio.streamCancel?.();
		v3Studio.streamCancel = null;
		v3Studio.error = null;
		v3Studio.stage = 'fill';
		startGenerationPolling(generationId);

		v3Studio.streamCancel = connectV3StudioGenerationStream(generationId, {
			onPoke: () => {
				void pollGenerationStatus(generationId);
			},

			onOpen: () => {
				void pollGenerationStatus(generationId);
			},

			onError: () => {
				void pollGenerationStatus(generationId);
			}
		});
	}

	async function handleChunkedApprove() {
		const chunked = v3Studio.chunkedState;

		if (!chunked) return;

		const generationId = chunked.generation_id;

		v3Studio.generationId = generationId;
		v3Studio.error = null;

		try {
			const structuralPlan = chunked.structural_plan;

			if (!structuralPlan) {
				throw new Error('The lesson plan is missing its structural plan.');
			}

			const learnPath = $.strict_equals(new URL(window.location.href).searchParams.get('path'), 'learn');
			const contractVersion = Number(structuralPlan.document_contract_version ?? 1);

			// Shared Units preparation stays on contract v1 until a path admits.
			// Learn still needs Review concepts to generate the teaching plan.
			if ($.strict_equals(contractVersion, 2) || learnPath) {
				const next = (await $.track_reactivity_loss(approveChunkedPlan(generationId, { display_title: $.get(displayTitle).trim() })))();

				if (learnPath) {
					(await $.track_reactivity_loss(applyChunkedState(next, { pollImmediately: true })))();

					return;
				}

				(await $.track_reactivity_loss(continueChunkedStage2(next)))();

				return;
			}

			throw new Error('Current lesson generation requires native document contract v2; legacy Builder conversion is unavailable.');
		} catch(err) {
			v3Studio.error = friendly(err);
			v3Studio.stage = 'skeleton';
		}
	}

	async function continueChunkedStage2(next) {
		if ($.strict_equals(next.stage, 'assembly_blocked') || $.strict_equals(next.stage, 'stage2_error')) {
			(await $.track_reactivity_loss(applyChunkedState(next)))();

			return;
		}

		if ($.strict_equals(next.stage, 'variants_running') && next.pack_id) {
			v3Studio.chunkedState = next;
			v3Studio.generationId = next.generation_id;
			(await $.track_reactivity_loss(goto('/units')))();

			return;
		}

		v3Studio.chunkedState = next;
		v3Studio.generationId = next.generation_id;
		hydrateChunkedSectionState(next);
		syncStage2Progress(next);

		// Approval returns stage2_running for native v3 plans. Move the visible
		// Studio stage at the same time as the stream/poller so the UI cannot
		// remain on the structural review screen while execution is underway.
		v3Studio.stage = 'fill';

		startGenerationPolling(next.generation_id);
		connectChunkedStage2Stream(next.generation_id);
	}

	async function handleChunkedResume() {
		const chunked = v3Studio.chunkedState;

		if (!chunked) return;

		$.set(recoveryBusy, true);
		v3Studio.error = null;

		try {
			const next = (await $.track_reactivity_loss(approveChunkedPlan(chunked.generation_id, { display_title: $.get(displayTitle).trim() })))();

			(await $.track_reactivity_loss(continueChunkedStage2(next)))();
		} catch(err) {
			v3Studio.error = friendly(err);
		} finally {
			$.set(recoveryBusy, false);
		}
	}

	async function handleTeachingApproachApprove() {
		const chunked = v3Studio.chunkedState;

		if (!chunked || !$.get(lessonApproach)) return;

		$.set(teachingApproveBusy, true);
		v3Studio.error = null;

		try {
			const review = $.get(lessonApproach).teaching_review || {};
			const requestedPath = $.strict_equals(new URL(window.location.href).searchParams.get('path'), 'learn') ? 'learn' : 'print';

			const approved = (await $.track_reactivity_loss(approveLessonApproach(chunked.generation_id, {
				expected_revision: Number(review.revision || 1),
				teacher_note: 'Approved',
				path: requestedPath
			})))();

			if ($.strict_equals(requestedPath, 'learn') || $.strict_equals(approved?.next, 'generate_learn') || $.strict_equals(approved?.path, 'learn')) {
				const body = (await $.track_reactivity_loss(realizeLearnFromGeneration(chunked.generation_id)))();

				const href = body.open_href || (body.editable_lesson_id
					? `/builder/${encodeURIComponent(body.editable_lesson_id)}`
					: null);

				if (href) {
					window.location.href = href;

					return;
				}
			}

			startGenerationPolling(chunked.generation_id, { immediate: true });
			v3Studio.stage = 'generating';
		} catch(err) {
			v3Studio.error = friendly(err);
		} finally {
			$.set(teachingApproveBusy, false);
		}
	}

	async function handleTeachingApproachReject() {
		const chunked = v3Studio.chunkedState;

