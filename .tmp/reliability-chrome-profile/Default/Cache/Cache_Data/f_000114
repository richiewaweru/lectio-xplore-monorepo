	async function handleChunkedRetrySection(sectionId) {
		const chunked = v3Studio.chunkedState;

		if (!chunked) return;

		disconnectActiveChunkedStream();
		v3Studio.error = null;
		v3Studio.stage = 'fill';

		try {
			const next = (await $.track_reactivity_loss(retryChunkedSection({ generation_id: chunked.generation_id, section_id: sectionId })))();

			v3Studio.chunkedState = next;
			hydrateChunkedSectionState(next);

			if ($.strict_equals(next.stage, 'assembly_blocked')) {
				disconnectActiveChunkedStream();
				v3Studio.stage = 'skeleton';
			} else if ($.strict_equals(next.stage, 'blueprint_ready')) {
				v3Studio.stage = 'fill';
				connectGenerationStream(next.generation_id);
