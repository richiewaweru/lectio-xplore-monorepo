n    \"document.writer_schema\"\\n  ]\\n}\\n\\n## SCOPED REQUEST\\n{\\n  \"inputs\": {\\n    \"allowed_facts\": [\\n      \"plants have roots, stems and leaves\",\\n      \"living things need food to grow\",\\n      \"Plants are living things that can produce their own food\",\\n      \"Plants are called producers\",\\n      \"Use one concrete classroom example.\",\\n      \"Explain that plants make their own food (are producers)\",\\n      \"Identify leaves as the site of photosynthesis and chlorophyll as the light-capturing substance\",\\n      \"Describe photosynthesis as using light, carbon dioxide, and water to produce food and oxygen\",\\n      \"Explain why light is essential for photosynthesis\"\\n    ],\\n    \"brief\": \"Define producer for a plant: a producer is a living thing that makes its own food. State plainly that the windowsill plant is a producer, so its food is made by the plant itself and is not something delivered to it from outside. Keep the definition to this single idea and do not yet describe how the plant makes the food or what role sunlight plays.\",\\n    \"kind\": \"paragraph\",\\n    \"lesson_context\": {\\n      \"input_availability\": \"supplied_statements\",\\n      \"objective\": \"Recognize that plants are producers that make their own food\",\\n      \"subject\": \"Science\",\\n      \"teaching_plan_revision\": 1,\\n      \"title\": \"The lesson opens on the classroom plant on the windowsill beside the cup of water and asks learners to commit to a guess about where its food comes from, so a personal wrong model is on the table. The explanation then fixes the category term \\\\u2014 the plant is a producer, a living thing that makes its own food \\\\u2014 and separates what the plant takes in through its roots from what it makes. The contrast section puts the producer idea against the soil-as-food and water-as-food readings on the same plant so the boundary is visible, and the close checks whether the learner now recognizes the plant, not the soil or the water, as the maker of the food.\"\\n    },\\n    \"neighbours\": [\\n      {\\n        \"kind\": \"callout\",\\n        \"reason\": \"Cues the learner to pause and commit to a personal guess about where the plant\\'s food comes from before any explanation, so the explanation has a held model to revise; the interaction itself is authored separately.\",\\n        \"role\": \"commit-prompt\",\\n        \"teaching_block_id\": \"orient-b1\"\\n      },\\n      {\\n        \"kind\": \"heading\",\\n        \"reason\": \"Introduces the category term \\'producer\\' to be fixed, keeping attention on the definition rather than the mechanism.\",\\n        \"role\": \"term-heading\",\\n        \"teaching_block_id\": \"explain-b1\"\\n      },\\n      {\\n        \"kind\": \"paragraph\",\\n        \"reason\": \"Separates what roots draw in (soil materials and water as raw materials) from the food the plant makes itself, relocating food-making inside the plant without yet naming errors.\",\\n        \"role\": \"intake-vs-made\",\\n        \"teaching_block_id\": \"explain-b2\"\\n      },\\n      {\\n        \"kind\": \"list\",\\n        \"reason\": \"Lists the two intakes and the made food compactly so the intake-versus-made boundary stays visible on the same plant.\",\\n        \"role\": \"side-by-side\",\\n        \"teaching_block_id\": \"explain-b2\"\\n      }\\n    ],\\n    \"reason\": \"States the single idea that a producer is a living thing that makes its own food and that the windowsill plant is a producer, with no sunlight or mechanism yet.\",\\n    \"role\": \"definition\",\\n    \"teaching_block\": {\\n      \"brief\": \"Define producer for a plant: a producer is a living thing that makes its own food. State plainly that the windowsill plant is a producer, so its food is made by the plant itself and is not something delivered to it from outside. Keep the definition to this single idea and do not yet describe how the plant makes the food or what role sunlight plays.\",\\n      \"evidence\": \"The objective\\'s verb is \\'recognize\\' a category, not explain a mechanism, so the slot needs the category term \\'producer\\' fixed precisely before any contrast with soil or water can mean anything.\",\\n      \"id\": \"explain-b1\",\\n      \"intent\": \"define\"\\n    },\\n    \"terminology\": []\\n  },\\n  \"mode\": \"generate\",\\n  \"scoped_request\": {\\n    \"allowed_facts\": [\\n      \"plants have roots, stems and leaves\",\\n      \"living things need food to grow\",\\n      \"Plants are living things that can produce their own food\",\\n      \"Plants are called producers\",\\n      \"Use one concrete classroom example.\",\\n      \"Explain that plants make their own food (are producers)\",\\n      \"Identify leaves as the site of photosynthesis and chlorophyll as the light-capturing substance\",\\n      \"Describe photosynthesis as using light, carbon dioxide, and water to produce food and oxygen\",\\n      \"Explain why light is essential for photosynthesis\"\\n    ],\\n    \"brief\": \"Define producer for a plant: a producer is a living thing that makes its own food. State plainly that the windowsill plant is a producer, so its food is made by the plant itself and is not something delivered to it from outside. Keep the definition to this single idea and do not yet describe how the plant makes the food or what role sunlight plays.\",\\n    \"evidence\": \"The objective\\'s verb is \\'recognize\\' a category, not explain a mechanism, so the slot needs the category term \\'producer\\' fixed precisely before any contrast with soil or water can mean anything.\",\\n    \"kind\": \"paragraph\",\\n    \"lesson_context\": {\\n      \"input_availability\": \"supplied_statements\",\\n      \"objective\": \"Recognize that plants are producers that make their own food\",\\n      \"subject\": \"Science\",\\n      \"teaching_plan_revision\": 1,\\n      \"title\": \"The lesson opens on the classroom plant on the windo