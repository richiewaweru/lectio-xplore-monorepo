{"timestamp": "2026-09-16T16:26:30.029275+00:00", "level": "DEBUG", "logger": "openai._base_client", "message": "HTTP Response: POST https://api.deepseek.com/chat/completions \"200 OK\" Headers({'content-type': 'application/json', 'transfer-encoding': 'chunked', 'connection': 'keep-alive', 'date': 'Wed, 16 Sep 2026 16:26:18 GMT', 'server': 'elb', 'content-encoding': 'gzip', 'vary': 'origin, access-control-request-method, access-control-request-headers', 'access-control-allow-credentials': 'true', 'x-ds-trace-id': '25a47b8714e007370af4fea6663c8f02', 'strict-transport-security': 'max-age=31536000; includeSubDomains; preload', 'x-content-type-options': 'nosniff', 'x-cache': 'Miss from cloudfront', 'via': '1.1 44815f98001068320c4224f49eaedf98.cloudfront.net (CloudFront)', 'x-amz-cf-pop': 'NBO50-P1', 'x-amz-cf-id': 'mrZVOyH06XGB_0wm7u5KKCV0ZijSDRAFOaYowzgzP03shzM7_9vrRg=='})"}
