ive_path\": \"document\",\\n  \"payload_schema\": {\\n    \"additionalProperties\": false,\\n    \"properties\": {\\n      \"caption\": {\\n        \"type\": \"string\"\\n      },\\n      \"headers\": {\\n        \"items\": {\\n          \"minLength\": 1,\\n          \"type\": \"string\"\\n        },\\n        \"minItems\": 1,\\n        \"type\": \"array\"\\n      },\\n      \"kind\": {\\n        \"const\": \"table\"\\n      },\\n      \"rows\": {\\n        \"items\": {\\n          \"items\": {\\n            \"type\": \"string\"\\n          },\\n          \"minItems\": 1,\\n          \"type\": \"array\"\\n        },\\n        \"minItems\": 1,\\n        \"type\": \"array\"\\n      }\\n    },\\n    \"required\": [\\n      \"kind\",\\n      \"headers\",\\n      \"rows\"\\n    ],\\n    \"type\": \"object\"\\n  },\\n  \"required_inputs\": [\\n    \"kind\",\\n    \"brief\",\\n    \"teaching_block\"\\n  ],\\n  \"validator_refs\": [\\n    \"document.writer_schema\"\\n  ]\\n}\\n\\n## SCOPED REQUEST\\n{\\n  \"inputs\": {\\n    \"allowed_facts\": [\\n      \"a primary source is a first-hand account created by someone who witnessed or took part in an event\",\\n      \"primary sources reflect the perspective and limits of their author, so accounts of the same event can differ\",\\n      \"read a short historical source and identify its author, date, and main claim\"\\n    ],\\n    \"brief\": \"Place two descriptions of the same anchor account \\\\u2014 Account A \\\\u2014 side by side. The weak description reports only the date and concludes that because the account is close to the event, it tells us what happened. The strong description uses all four features: it names what is known and unknown about the author and the author\\'s position, uses the date to state what the account could and could not observe, names the type and what that type of source typically records, and states the author\\'s purpose or the purpose the account carries implied, then draws a one-sentence limit