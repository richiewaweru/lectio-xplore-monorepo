fcdb7:04c25319-eaa8-488c-9f5d-f9ee348fcdb7:7f4fe57d-a07f-4d0a-92a0-185ffbefee02.i4\",\\n        \"kind\": \"multiple_choice\",\\n        \"stem\": \"Four straight roads are drawn on a map grid with these slopes: Road W has slope 0, Road X has slope 2, Road Y has slope -3, and Road Z has an undefined slope. Which set describes the roads from flattest to steepest, ignoring direction?\"\\n      },\\n      {\\n        \"allowed_actions\": [\\n          \"select-many\",\\n          \"select-one\"\\n        ],\\n        \"approved_item_id\": \"04c25319-eaa8-488c-9f5d-f9ee348fcdb7:04c25319-eaa8-488c-9f5d-f9ee348fcdb7:7f4fe57d-a07f-4d0a-92a0-185ffbefee02.i5\",\\n        \"evidence_ref\": \"item.04c25319-eaa8-488c-9f5d-f9ee348fcdb7:04c25319-eaa8-488c-9f5d-f9ee348fcdb7:7f4fe57d-a07f-4d0a-92a0-185ffbefee02.i5\",\\n        \"kind\": \"multiple_choice\",\\n        \"stem\": \"A hiking trail is modeled by a line through (0, 10) and (5, 20). A second trail is modeled by a line through (0, 10) and (5, 30). How do the slopes tell you what the trails do, and what does the shared point show?\"\\n      }\\n    ],\\n    \"eligible_intents\": [\\n      \"activate-prior-knowledge\",\\n      \"apply\",\\n      \"check-understanding\",\\n      \"classify\",\\n      \"compare\",\\n      \"connect-back\",\\n      \"diagnose-misconception\",\\n      \"explain-cause\",\\n      \"interpret\",\\n      \"orient\",\\n      \"practise-guided\",\\n      \"practise-independent\",\\n      \"sequence\"\\n    ],\\n    \"forbidden_terminology\": [],\\n    \"required_assessment_slots\": [\\n      \"check\"\\n    ],\\n    \"rules\": {\\n      \"action_must_be_from_bound_source_allowed_actions\": true,\\n      \"copy_evidence_refs_verbatim\": true,\\n      \"copy_ids_verbatim\": true,\\n      \"item_kind_is_fixed_upstream\": true,\\n      \"multiple_choice_ids_per_block\": \"0_or_1\",\\n      \"response_action_requires_approved_source\": true,\\n      \"reuse_across_blocks\": \"forbidden\",\\n      \"source_only_in_required_assessment_slots\": true,\\n      \"source_only_on_eligible_intent\": true,\\n      \"source_requires_learner_action\": true\\n    }\\n  },\\n  \"fixed_input\": {\\n    \"anchor\": {\\n      \"description\": \"A straight ramp: the slope number tells both how steep the ramp is and whether you are walking up i\\\\u2026\",\\n      \"id\": \"anchor-1\"\\n    },\\n    \"approved_item_ids\": [\\n      \"04c25319-eaa8-488c-9f5d-f9ee348fcdb7:04c25319-eaa8-488c-9f5d-f9ee348fcdb7:7f4fe57d-a07f-4d0a-92a0-185ffbefee02.i1\",\\n      \"04c25319-eaa8-488c-9f5d-f9ee348fcdb7:04c25319-eaa8-488c-9f5d-f9ee348fcdb7:7f4fe57d-a07f-4d0a-92a0-185ffbefee02.i2\",\\n      \"04c25319-eaa8-488c-9f5d-f9ee348fcdb7:04c25319-eaa8-488c-9f5d-f9ee348fcdb7:7f4fe57d-a07f-4d0a-92a0-185ffbefee02.i3\",\\n      \"04c25319-eaa8-488c-9f5d-f9ee348fcdb7:04c25319-eaa8-488c-9f5d-f9ee348fcdb7:7f4fe57d-a07f-4d0a-92a0-185ffbefee02.i4\",\\n      \"04c25319-eaa8-488c-9f5d-f9ee348fcdb7:04c25319-eaa8-488c-9f5d-f9ee348fcdb7:7f4fe57d-a07f-4d0a-92a0-185ffbefee02.i5\"\\n    ],\\n    \"lesson\": {\\n      \"grade_level\": \"Grade\",\\n      \"knowledge_type\": \"conceptual\",\\n      \"lesson_mode\": \"first_exposure\",\\n      \"objective\": \"Explain what the numerical sign and size of a slope tell about how steep a line is and whether it rises, falls, is horizontal, or is vertical.\",\\n      \"path_lesson_id\": \"04c25319-eaa8-488c-9f5d-f9ee348fcdb7\",\\n      \"subject\": \"Mathematics\"\\n    },\\n    \"limits\": {\\n      \"max_blocks_per_section\": 3,\\n      \"max_sections\": 4,\\n      \"max_total_blocks\": 10\\n    },\\n    \"misconceptions\": [\\n      {\\n        \"id\": \"m1\",\\n        \"statement\": \"{\\'id\\': \\'m1\\', \\'description\\': \\'A bigger slope number always means a steeper line.\\', \\'source\\': \\'drafted\\'}\"\\n      },\\n      {\\n        \"id\": \"m2\",\\n        \"statement\": \"{\\'id\\': \\'m2\\', \\'description\\': \\'Zero slope and undefined slope describe the same kind of line.\\', \\'source\\': \\'drafted\\'}\"\\n      },\\n      {\\n        \"id\": \"m3\",\\n        \"statement\": \"{\\'id\\': \\'m3\\', \\'description\\': \\'Slope tells you where the line sits on the grid, not just its direction and steepness.\\', \\'source\\': \\'drafted\\'}\"\\n      }\\n    ],\\n    \"prior_established\": [\\n      {\\n        \"id\": \"prior-1\",\\n        \"statement\": \"plot and read coordinates of points on the Cartesian plane\"\\n      },\\n      {\\n        \"id\": \"prior-2\",\\n        \"statement\": \"plot a straight line from a table of values or an equation of the form y = mx + c\"\\n      },\\n      {\\n        \"id\": \"prior-3\",\\n        \"statement\": \"identify the x-axis, y-axis and origin\"\\n      },\\n      {\\n        \"id\": \"prior-4\",\\n        \"statement\": \"Slope compares a vertical change to a corresponding horizontal change\"\\n      },\\n      {\\n        \"id\": \"prior-5\",\\n        \"statement\": \"A constant slope means equal horizontal steps produce equal vertical steps\"\\n      },\\n      {\\n        \"id\": \"prior-6\",\\n        \"statement\": \"The slope of a line can be read as a rate of change with units from the context\"\\n      },\\n      {\\n        \"id\": \"prior-7\",\\n        \"statement\": \"Two distinct points on a line determine its slope\"\\n      },\\n      {\\n        \"id\": \"prior-8\",\\n        \"statement\": \"Rise is the vertical change between the points; run is the horizontal change\"\\n      },\\n      {\\n        \"id\": \"prior-9\",\\n        \"statement\": \"Slope is calculated as rise divided by run from the graph\"\\n      },\\n      {\\n        \"id\": \"prior-10\",\\n        \"statement\": \"The same slope results from any two points chosen on the same line\"\\n      },\\n      {\\n        \"id\": \"prior-11\",\\n        \"statement\": \"The slope formula relates the change in y to the change in x between two points\"\\n      },\\n      {\\n        \"id\": \"prior-12\",\\n        \"statement\": \"Order of subtraction must be consistent in numerator and denominator\"\\n      },\\n      {\\n        \"id\": \"prior-13\",\\n        \"statement\": \"The computed slope is the same regardless of which point is treated as the first point\"\\n      }\\n    ],\\n    \"required_assessment_slots\": [\\n      \"check\"\\n    ],\\n    \"required_visual_slots\": [],\\n    \"scope\": {\\n      \"must_establish\": [],\\n      \"must_not_introduce\": [],\\n      \"terminology\": []\\n    },\\n    \"slots\": [\\n      {\\n        \"max_blocks\": 2,\\n        \"min_blocks\": 1,\\n        \"purpose\": \"Give the learner a reason to care and a concrete situation to hold.\",\\n        \"slot_id\": \"orient\",\\n        \"typical_intents\": [\\n          \"orient\",\\n          \"activate-prior-knowledge\",\\n          \"emphasise\"\\n        ],\\n        \"visual_required\": false\\n      },\\n      {\\n        \"max_blocks\": 3,\\n        \"min_blocks\": 1,\\n        \"purpose\": \"Build the idea itself. State it, ground it, make it usable.\",\\n        \"slot_id\": \"explain\",\\n        \"typical_intents\": [\\n          \"explain-cause\",\\n          \"explain\",\\n          \"define\",\\n          \"show-structure\",\\n          \"trace-flow\",\\n          \"compare\",\\n          \"name-parts\"\\n        ],\\n        \"visual_required\": false\\n      },\\n      {\\n        \"max_blocks\": 3,\\n        \"min_blocks\": 1,\\n        \"purpose\": \"Put a case and a near-miss side by side. The learner must see the boundary of the idea, not just the idea.\\\\n\",\\n        \"slot_id\": \"contrast\",\\n        \"typical_intents\": [\\n          \"compare\",\\n          \"classify\",\\n          \"explain\",\\n          \"warn\",\\n          \"show-structure\"\\n        ],\\n        \"visual_required\": false\\n      },\\n      {\\n        \"max_blocks\": 2,\\n        \"min_blocks\": 1,\\n        \"purpose\": \"Name the wrong belief, show why it 