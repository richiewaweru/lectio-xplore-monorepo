e_path\": \"document\",\\n  \"payload_schema\": {\\n    \"additionalProperties\": false,\\n    \"properties\": {\\n      \"items\": {\\n        \"items\": {\\n          \"minLength\": 1,\\n          \"type\": \"string\"\\n        },\\n        \"minItems\": 1,\\n        \"type\": \"array\"\\n      },\\n      \"kind\": {\\n        \"const\": \"list\"\\n      },\\n      \"ordered\": {\\n        \"type\": \"boolean\"\\n      }\\n    },\\n    \"required\": [\\n      \"kind\",\\n      \"ordered\",\\n      \"items\"\\n    ],\\n    \"type\": \"object\"\\n  },\\n  \"required_inputs\": [\\n    \"kind\",\\n    \"brief\",\\n    \"teaching_block\"\\n  ],\\n  \"validator_refs\": [\\n    \"document.writer_schema\"\\n  ]\\n}\\n\\n## SCOPED REQUEST\\n{\\n  \"inputs\": {\\n    \"allowed_facts\": [\\n      \"read and understand a short passage\",\\n      \"find details in a text\",\\n      \"A claim is what the writer asserts as true.\",\\n      \"The claim can be stated in a single sentence.\",\\n      \"Recognizing a writer\\'s claim in a short passage\",\\n      \"Distinguishing evidence that directly supports a claim from unrelated details\",\\n      \"Explaining the link between selected evidence and the claim\"\\n    ],\\n    \"brief\": \"Give the rule for sorting sentences: a sentence belongs to the writer\\'s claim only if the writer is asserting it as true and wants the reader to accept it; a sentence that names the subject or gives a supporting reason is not the claim. Use the anchor passage\\'s sentences as the sorting cases and have the learner place each one, guided by the rule just stated. Do not use sentences from outside the anchor here \\\\u2014 the sorting is on familiar ground.\",\\n    \"kind\": \"list\",\\n    \"lesson_context\": {\\n      \"input_availability\": \"supplied_statements\",\\n      \"objective\": \"Identify the writer\\'s claim in a short passage by stating what the writer is asserting as true.\",\\n      \"sourcebook_entries\": [],\\n      \"subject\": \"English Language Arts\",\\n      \"teaching_plan_revision\": 1,\\n      \"title\": \"The lesson opens on the anchor passage, where one sentence is the writer\\'s claim and the others merely support it, and gives learners a reason to care about telling them apart. It builds the idea that a claim is the statement the writer asserts as true and wants readers to accept, then puts a topic sentence and a supporting fact side by side with the claim so the boundary is visible. It then surfaces the three beliefs that leak in \\\\u2014 that the claim is the topic, that any true sentence is the claim, and that the claim is always first \\\\u2014 and shows each failing on the same passage. It closes by having learners pick the writer\\'s claim from a fresh short passage on their own.\"\\n    },\\n    \"neighbours\": [\\n      {\\n        \"kind\": \"paragraph\",\\n        \"reason\": \"Makes explicit that all three sentences are true statements about the same passage and that the topic sentence and supporting fact are doing different jobs than the claim.\",\\n        \"role\": \"boundary-statement\",\\n        \"teaching_block_id\": \"contrast-b1\"\\n      },\\n      {\\n        \"kind\": \"callout\",\\n        \"reason\": \"States the sorting rule plainly \\\\u2014 a sentence counts as the claim only if the writer asserts it as true and wants the reader to accept it \\\\u2014 so the classification task has a stated criterion to apply.\",\\n        \"role\": \"sorting-rule\",\\n        \"teaching_block_id\": \"contrast-b2\"\\n      },\\n      {\\n        \"kind\": \"paragraph\",\\n        \"reason\": \"States the belief that the claim is whatever the passage is about and shows why it feels right, surfacing the held belief rather than dismissing it.\",\\n        \"role\": \"misconception-statement\",\\n        \"teaching_block_id\": \"confront-b1\"\\n      },\\n      {\\n        \"kind\": \"callout\",\\n        \"reason\": \"Fails the misconception on the anchor \\\\u2014 