   \"incorrect\"\\n            ],\\n            \"type\": \"object\"\\n          },\\n          \"prompt\": {\\n            \"minLength\": 1,\\n            \"type\": \"string\"\\n          }\\n        },\\n        \"required\": [\\n          \"prompt\",\\n          \"config\",\\n          \"feedback\"\\n        ],\\n        \"type\": \"object\"\\n      },\\n      \"payload_schema_ref\": \"learn/choice/config.v1\",\\n      \"purpose\": \"Let a learner choose the one correct option from a closed set.\",\\n      \"required_inputs\": [\\n        \"teaching_plan_block\",\\n        \"learn_selection_decision\",\\n        \"lesson_context\",\\n        \"allowed_facts\",\\n        \"terminology\",\\n        \"learner_action\",\\n        \"approved_items_when_converting\"\\n      ],\\n      \"requires\": [\\n        \"at least two options with unique non-empty ids\",\\n        \"exactly one correct_option_id, and it must name a declared option\",\\n        \"keyboard-operable option selection\"\\n      ],\\n      \"schema_ref\": \"learn/choice/config.v1\",\\n      \"source_refs\": [\\n        \"apps/textbook-agent/frontend/src/lib/learn/interactions/ChoiceInteraction.svelte\",\\n        \"contracts/authoring/instructions/choice-writer-v1.txt\",\\n        \"learn/choice/config.v1\",\\n        \"apps/textbook-agent/frontend/src/lib/learn/interactions/interaction-contract.ts#evaluateChoice\"\\n      ],\\n      \"validator_refs\": [\\n        \"learn.payload_schema\",\\n        \"learn.evaluateChoice\"\\n      ]\\n    },\\n    \"authoring_mode\": \"new\",\\n    \"block_id\": \"orient-b1\",\\n    \"brief\": \"Present the concrete case: a potted classroom plant on the windowsill, sitting next to a cup of water. Ask learners where they think the plant\\'s food comes from and have them commit to one answer before anything is explained. Do not name soil, water, or sunlight as food, and do not state the target idea that the plant makes its own food.\",\\n    \"capability_contract_hash