then fixes the category term \\\\u2014 the plant is a producer, a living thing that makes its own food \\\\u2014 and separates what the plant takes in through its roots from what it makes. The contrast section puts the producer idea against the soil-as-food and water-as-food readings on the same plant so the boundary is visible, and the close checks whether the learner now recognizes the plant, not the soil or the water, as the maker of the food.\"\\n    },\\n    \"teaching_plan_block\": {\\n      \"action\": \"select-one\",\\n      \"block_id\": \"orient-b1\",\\n      \"brief\": \"Present the concrete case: a potted classroom plant on the windowsill, sitting next to a cup of water. Ask learners where they think the plant\\'s food comes from and have them commit to one answer before anything is explained. Do not name soil, water, or sunlight as food, and do not state the target idea that the plant makes its own food.\",\\n      \"evidence\": \"The objective\\'s recognition claim only becomes meaningful if the learner first holds the concrete windowsill plant and a personal guess to revise, and this is the only place the anchor can be introduced.\",\\n      \"intent\": \"orient\",\\n      \"section_id\": \"orient\"\\n    },\\n    \"terminology\": []\\n  },\\n  \"mode\": \"generate\",\\n  \"resolved_policy\": {\\n    \"assessment_policy_source\": \"package:1.0.0\",\\n    \"definition_hash\": \"9c9eca46dacb6c6603192a541ee7c019236a8ab713137ae9027d3e3557c1c7eb\",\\n    \"definition_version\": \"2.0.0\",\\n    \"effective_assessment_policy\": \"automatic_required\",\\n    \"effective_knowledge_policy\": \"supplied_preferred\",\\n    \"executed_evaluation_mode\": \"accepted-answers\",\\n    \"executed_knowledge_mode\": \"supplied_facts\",\\n    \"fallback_reason\": null,\\n    \"input_availability\": \"supplied_statements\",\\n    \"input_revision\": null,\\n    \"knowledge_policy_source\": \"package:1.0.0\",\\n    \"policy_version\": \"1.0.0\",\\n    \"requested_assessment_policy\": null,\\n    \"requested_knowledge_policy\": null,\\n    \"teacher_review_permitted\": false\\n  },\\n  \"scoped_request\": {\\n    \"action\": \"select-one\",\\n    \"allowed_facts\": [\\n      \"plants have roots, stems and leaves\",\\n      \"living things need food to grow\",\\n      \"Plants are living things that can produce their own food\",\\n      \"Plants are called producers\",\\n      \"Use one concrete classroom example.\",\\n      \"Explain that plants make their own food (are producers)\",\\n      \"Identify leaves as the site of photosynthesis and chlorophyll as the light-capturing substance\",\\n      \"Describe photosynthesis as using light, carbon dioxide, and water to produce food and oxygen\",\\n      \"Explain why light is essential for photosynthesis\"\\n    ],\\n    \"authoring_definition\": {\\n      \"assessment\": {\\n        \"default\": \"automatic_required\",\\n        \"supported\": [\\n          \"automatic_required\"\\n        ],\\n        \"teacher_review_permitted\": false\\n      },\\n      \"asset_requirements\": null,\\n      \"capability_id\": \"choice\",\\n      \"capacity\": {\\n        \"optionMaxWords\": 20,\\n        \"optionsMax\": 5,\\n        \"optionsMin\": 2,\\n        \"stemMaxWords\": 40\\n      },\\n      \"config_schema\": {\\n        \"$id\": \"learn/choice/config.v1\",\\n        \"additionalProperties\": false,\\n        \"properties\": {\\n          \"correct_option_id\": {\\n            \"minLength\": 1,\\n            \"type\": \"string\"\\n          },\\n          \"options\": {\\n            \"items\": {\\n              \"additionalProperties\": false,\\n              \"properties\": {\\n                \"explanation\": {\\n                  \"type\": \"string\"\\n                },\\n                \"id\": {\\n                  \"minLength\": 1,\\n                  \"type\": \"string\"\\n                },\\n                \"text\": {\\n                  \"minLength\": 1,\\n                  \"type\": \"string\"\\n                }\\n              },\\n              \"required\": [\\n                \"id\",\\n                \"text\"\\n              ],\\n              \"type\": \"object\"\\n            },\\n            \"minItems\": 2,\\n            \"type\": \"array\",\\n            \"uniqueItems\": true\\n          },\\n          \"presentation\": {\\n            \"enum\": [\\n              \"text\",\\n              \"image\"\\n            ]\\n          }\\n        },\\n        \"required\": [\\n          \"options\",\\n          \"correct_option_id\"\\n        ],\\n        \"type\": \"object\"\\n      },\\n      \"converter_ref\": \"learn.choice.approved_item_converter\",\\n      \"definition_hash\": \"9c9eca46dacb6c6603192a541ee7c019236a8ab713137ae9027d3e3557c1c7eb\",\\n      \"definition_version\": \"2.0.0\",\\n      \"examples\": [\\n        {\\n          \"correct_option_id\": \"air\",\\n          \"options\": [\\n            {\\n              \"explanation\": \"Mass is not drawn from soil.\",\\n              \"id\": \"soil\",\\n              \"text\": \"From the soil\"\\n            },\\n            {\\n              \"id\": \"air\",\\n              \"text\": \"From carbon dioxide in the air\"\\n            },\\n            {\\n              \"explanation\": \"Light supplies energy, not mass.\",\\n              \"id\": \"light\",\\n              \"text\": \"From sunlight alone\"\\n            }\\n          ]\\n        }\\n      ],\\n      \"field_guidance\": {\\n        \"config.correct_option_id\": \"Must equal the id of exactly one declared option.\",\\n        \"config.options\": \"Stable ids, parallel grammatical form. Give each wrong option an explanation naming the misconception it reveals.\",\\n        \"config.presentation\": \"\\'image\\' renders options as pictures; evaluation is identical, so do not author a separate kind for it.\",\\n        \"feedback.correct\": \"Short message shown when the learner answer is fully correct.\",\\n    