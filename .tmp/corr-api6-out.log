"items\"\\n    ],\\n    \"type\": \"object\"\\n  },\\n  \"required_inputs\": [\\n    \"kind\",\\n    \"brief\",\\n    \"teaching_block\"\\n  ],\\n  \"validator_refs\": [\\n    \"document.writer_schema\"\\n  ]\\n}\\n\\n## SCOPED REQUEST\\n{\\n  \"inputs\": {\\n    \"allowed_facts\": [\\n      \"plants have roots, stems and leaves\",\\n      \"living things need food to grow\",\\n      \"Plants are living things that can produce their own food\",\\n      \"Plants are called producers\",\\n      \"Use one concrete classroom example.\",\\n      \"Explain that plants make their own food (are producers)\",\\n      \"Identify leaves as the site of photosynthesis and chlorophyll as the light-capturing substance\",\\n      \"Describe photosynthesis as using light, carbon dioxide, and water to produce food and oxygen\",\\n      \"Explain why light is essential for photosynthesis\"\\n    ],\\n    \"brief\": \"Set the water-as-food reading against the target on the same windowsill plant beside the cup of water: one learner says the plant\\'s food is the water we give it, since water is what we pour in; the producer idea says the plant makes its own food and the water is an intake, not the food. Make clear that pouring more water does not feed the plant in the sense of food, and that the plant remains the maker. Do not re-run the soil argument and do not treat sunlight as food or as energy here.\",\\n    \"kind\": \"list\",\\n    \"lesson_context\": {\\n      \"input_availability\": \"supplied_statements\",\\n      \"objective\": \"Recognize that plants are producers that make their own food\",\\n      \"subject\": \"Science\",\\n      \"teaching_plan_revision\": 1,\\n      \"title\": \"The lesson opens on the classroom plant on the windowsill beside the cup of water and asks learners to commit to a guess about where its food comes from, so a personal wrong model is on the table. The explanation then fixes the category term \\\\u2014 the plant is a producer, a living thing that makes its own food \\\\u2014 and separates what the plant takes in through its roots from what it makes. The contrast section puts the producer idea against the soil-as-food and water-as-food readings on the same plant so the boundary is visible, and the close checks whether the learner now recognizes the plant, not the soil or the water, as the maker of the food.\"\\n    },\\n    \"neighbours\": [\\n      {\\n        \"kind\": \"callout\",\\n        \"reason\": \"Surfaces whether the learner still holds the soil-as-food model by prompting a choice between the two readings.\",\\n        \"role\": \"diagnostic-prompt\",\\n        \"teaching_block_id\": \"contrast-b1\"\\n      },\\n      {\\n        \"kind\": \"paragraph\",\\n        \"reason\": \"Sets the water-as-food reading against the producer idea on the same plant beside the cup of water.\",\\n        \"role\": \"contrast\",\\n        \"teaching_block_id\": \"contrast-b2\"\\n      },\\n      {\\n        \"kind\": \"paragraph\",\\n        \"reason\": \"Poses one application check about where the windowsill plant\\'s food comes from, keeping to a single recognition of the plant as producer.\",\\n        \"role\": \"check-prompt\",\\n        \"teaching_block_id\": \"check-b1\"\\n      }\\n    ],\\n    \"reason\": \"Lays out the water-as-food claim against the producer idea so the boundary of the concept is visible.\",\\n    \"role\": \"comparison\",\\n    \"teaching_block\": {\\n      \"brief\": \"Set the water-as-food reading against the target on the same windowsill plant beside the cup of water: one learner says the plant\\'s food is the water we give it, since water is what we pour in; the producer idea says the plant makes its own food and the water is an intake, not the food. Make clear that pouring more water does not feed the plant in the sense of food, and that the plant remains the maker. Do not re-run the soil argument and do not treat sunlight as food or as energy here.\",\\n      \"evidence\": \"M2 is a second named belief that places food outside the plant, and because the anchor already includes the cup of water, this block can test that belief against a case the learner has held since the opening instead of a fresh example.\",\\n      \"id\": \"contrast-b2\",\\n      \"intent\": \"diagnose-misconception\"\\n    },\\n    \"terminology\": []\\n  },\\n  \"mode\": \"generate\",\\n  \"scoped_request\": {\\n    \"allowed_facts\": [\\n      \"plants have roots, stems and leaves\",\\n      \"living things need food to grow\",\\n      \"Plants are living things that can produce their own food\",\\n      \"Plants are called producers\",\\n      \"Use one concrete classroom example.\",\\n      \"Explain that plants make their own food (are producers)\",\\n      \"Identify leaves as the site of photosynthesis and chlorophyll as the light-capturing substance\",\\n      \"Describe photosynthesis as using light, carbon dioxide, and water to produce food and oxygen\",\\n      \"Explain why light is essential for photosynthesis\"\\n    ],\\n    \"brief\": \"Set the water-as-food reading against the target on the same windowsill plant beside the cup of water: one learner says the plant\\'s food is the water we give it, since water is what we pour in; the producer idea says the plant makes its own food and the water is an intake, not the food. Make clear that pouring more water does not feed the plant in the sense of food, and that the plant remains the maker. Do not re-run the soil argument and do not treat sunlight as food or as energy here.\",\\n    \"evidence\": \"M2 is a second named belief that places food outside the plant, and because the anchor already includes the cup of water, this block can test that belief against a case the learner has held since the opening instead of a fresh example.\",\\n    \"kind\": \"list\",\\n    \"lesson_context\": {\\n      \"input_availability\": \"supplied_statements\",\\n      \"objective\": \"Recognize that plants are producers that make their own food\",\\n      \"subject\": \"Science\",\\n      \"teaching_plan_revision\": 1,\\n      \"title\": \"The lesson opens on the classroom plant on the windowsill beside the cup of water and asks learners to commit to a guess about where its food comes from, so a personal wrong model is on the table. The explanation then fixes the category term \\\\u2014 the plant is a producer, a living thing that makes its own food \\\\u2014 and separates what the plant takes in through its roots from what it makes. The contrast section puts the producer idea against the soil-as-food and water-as-food readings on the same plant so the boundary is visible, and the close checks whether the learner now recognizes the plant, not the soil or the water, as the maker of the food.\"\\n    },\\n    \"neighbours\": [\\n      {\\n        \"kind\": \"callout\",\\n        \"reason\": \"Surfaces whether the learner still holds the soil-as-food model by prompting a choice between the two readings.\",\\n        \"role\": \"diagnostic-prompt\",\\n        \"teaching_block_id\": \"contrast-b1\"\\n      },\\n      {\\n        \"kind\": \"paragraph\",\\n        \"reason\": \"Sets the water-as-food reading against the producer idea on the same plant beside the cup of water.\",\\n        \"role\": \"contrast\",\\n        \"teaching_block_id\": \"contrast-b2\"\\n      },\\n      {\\n        \"kind\": \"paragraph\",\\n        \"reason\": \"Poses one application check about where the windowsill plant\\'s food comes from, keeping to a single recognition of the plant as producer.\",\\n        \"role\": \"check-prompt\",\\n        \"teaching_block_id\": \"check-b1\"\\n      }\\n    ],\\n    \"objective\": \"Recognize that plants are producers that make their own food\",\\n    \"reason\": \"Lays out the water-as-food claim against the producer idea so the boundary of the concept is visible.\",\\n    \"role\": \"comparison\",\\n    \"stage\": \"document_writing\",\\n    \"teaching_block\": {\\n      