n    \"document.writer_schema\"\\n  ]\\n}\\n\\n## SCOPED REQUEST\\n{\\n  \"inputs\": {\\n    \"allowed_facts\": [\\n      \"plants have roots, stems and leaves\",\\n      \"living things need food to grow\",\\n      \"Plants are living things that can produce their own food\",\\n      \"Plants are called producers\",\\n      \"Use one concrete classroom example.\",\\n      \"Explain that plants make their own food (are producers)\",\\n      \"Identify leaves as the site of photosynthesis and chlorophyll as the light-capturing substance\",\\n      \"Describe photosynthesis as using light, carbon dioxide, and water to produce food and oxygen\",\\n      \"Explain why light is essential for photosynthesis\"\\n    ],\\n    \"brief\": \"Set the water-as-food reading against the target on the same windowsill plant beside the cup of water: one learner says the plant\\'s food is the water we give it, since water is what we pour in; the producer idea says the plant makes its own food and the water is an intake, not the food. Make clear that pouring more water does not feed the plant in the sense of food, and that the plant remains the maker. Do not re-run the soil argument and do not treat sunlight as food or as energy here.\",\\n    \"kind\": \"paragraph\",\\n    \"lesson_context\": {\\n      \"input_availability\": \"supplied_statements\",\\n      \"objective\": \"Recognize that plants are producers that make their own food\",\\n      \"subject\": \"Science\",\\n      \"teaching_plan_revision\": 1,\\n      \"title\": \"The lesson opens on the classroom plant on the windowsill beside the cup of water and asks learners to commit to a guess about where its food comes from, so a personal wrong model is on the table. The explanation then fixes the category term \\\\u2014 the plant is a producer, a living thing that makes its own food \\\\u2014 and separates what the plant takes in through its roots from what it makes. The contrast section puts the producer idea against the soil-as-food and water-as-food readings on the same plant so the boundary is visible, and the close checks whether the learner now recognizes the plant, not the soil or the water, as the maker of the food.\"\\n    },\\n    \"neighbours\": [\\n      {\\n        \"kind\": \"paragraph\",\\n        \"reason\": \"Places the soil-as-food reading beside the target on the same windowsill plant and shows why it cannot stand, since the plant still makes food inside itself.\",\\n        \"role\": \"diagnose-misconception\",\\n        \"teaching_block_id\": \"contrast-b1\"\\n      },\\n      {\\n        \"kind\": \"callout\",\\n        \"reason\": \"Alerts learners to the select-one that surfaces whether they still hold the soil-as-food model, without restating the full intake-versus-made distinction.\",\\n        \"role\": \"practice-cue\",\\n        \"teaching_block_id\": \"contrast-b1\"\\n      },\\n      {\\n        \"kind\": \"callout\",\\n        \"reason\": \"Sharpens the boundary of the producer idea so learners see that neither soil nor water is the food, while avoiding a re-run of the soil argument.\",\\n        \"role\": \"boundary-note\",\\n        \"teaching_block_id\": \"contrast-b2\"\\n      },\\n      {\\n        \"kind\": \"heading\",\\n        \"reason\": \"Signals the closing recognition check so learners know the lesson ends by applying the producer idea to the windowsill plant.\",\\n        \"role\": \"check\",\\n        \"teaching_block_id\": \"check-b1\"\\n      }\\n    ],\\n    \"reason\": \"Tests the water-as-food reading against the same plant and cup of water from the opening, making clear that poured water is an intake rather than food and the plant remains the maker.\",\\n    \"role\": \"diagnose-misconception\",\\n    \"teaching_block\": {\\n      \"brief\": \"Set the water-as-food reading against the target on the same windowsill plant beside the cup of water: one learner says the plant\\'s food is the water we give it, since water is what we pour in; 