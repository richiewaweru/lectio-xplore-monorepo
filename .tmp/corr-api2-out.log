\": [\\n      {\\n        \"id\": \"prior-1\",\\n        \"statement\": \"plants have roots, stems and leaves\"\\n      },\\n      {\\n        \"id\": \"prior-2\",\\n        \"statement\": \"living things need food to grow\"\\n      }\\n    ],\\n    \"required_visual_slots\": [],\\n    \"scope\": {\\n      \"must_establish\": [],\\n      \"must_not_introduce\": [],\\n      \"terminology\": []\\n    },\\n    \"slots\": [\\n      {\\n        \"max_blocks\": 2,\\n        \"min_blocks\": 1,\\n        \"purpose\": \"Give the learner a reason to care and a concrete situation to hold.\",\\n        \"slot_id\": \"orient\",\\n        \"typical_intents\": [\\n          \"orient\",\\n          \"activate-prior-knowledge\",\\n          \"emphasise\"\\n        ],\\n        \"visual_required\": false\\n      },\\n      {\\n        \"max_blocks\": 3,\\n        \"min_blocks\": 1,\\n        \"purpose\": \"Build the idea itself. State it, ground it, make it usable.\",\\n        \"slot_id\": \"explain\",\\n        \"typical_intents\": [\\n          \"explain-cause\",\\n          \"explain\",\\n          \"define\",\\n          \"show-structure\",\\n          \"trace-flow\",\\n          \"compare\",\\n          \"name-parts\"\\n        ],\\n        \"visual_required\": false\\n      },\\n      {\\n        \"max_blocks\": 3,\\n        \"min_blocks\": 1,\\n        \"purpose\": \"Put a case and a near-miss side by side. The learner must see the boundary of the idea, not just the idea.\\\\n\",\\n        \"slot_id\": \"contrast\",\\n        \"typical_intents\": [\\n          \"compare\",\\n          \"classify\",\\n          \"explain\",\\n          \"warn\",\\n          \"show-structure\"\\n        ],\\n        \"visual_required\": false\\n      },\\n      {\\n        \"max_blocks\": 1,\\n        \"min_blocks\": 1,\\n        \"purpose\": \"The shared diagnostic. Identical across every variant. Written from the card only, never from the prose above it.\\\\n\",\\n        \"slot_id\": \"check\",\\n        \"typical_intents\": [\\n          \"check-understanding\",\\n          \"practise-independent\",\\n          \"diagnose-misconception\"\\n        ],\\n        \"visual_required\": false\\n      }\\n    ]\\n  },\\n  \"legality_catalogue_hash\": \"c0250ed98d2f5abca69c19e4cc866ed36f855b8b33ad2c4fdd12ed3ba64db415\",\\n  \"slot_intent_policy\": {\\n    \"check\": {\\n      \"departure_rule\": \"A permitted non-typical intent requires a specific departure_reason. Excluded intents are never legal.\",\\n      \"permitted_departures\": [\\n        \"activate-prior-knowledge\",\\n        \"apply\",\\n        \"classify\",\\n        \"compare\",\\n        \"connect-back\",\\n        \"connect-forward\",\\n        \"define\",\\n        \"demonstrate\",\\n        \"derive\",\\n        \"emphasise\",\\n        \"explain\",\\n        \"explain-cause\",\\n        \"interpret\",\\n        \"memory-aid\",\\n        \"name-parts\",\\n        \"orient\",\\n        \"practise-guided\",\\n        \"sequence\",\\n        \"show-structure\",\\n        \"summarise\",\\n        \"trace-flow\",\\n        \"warn\"\\n      ],\\n      \"typical_intents\": [\\n        \"check-understanding\",\\n        \"diagnose-misconception\",\\n        \"practise-independent\"\\n      ]\\n    },\\n    \"contrast\": {\\n      \"departure_rule\": \"A permitted non-typical intent requires a specific departure_reason. Excluded intents are never legal.\",\\n      \"permitted_departures\": [\\n        \"activate-prior-knowledge\",\\n        \"apply\",\\n        \"check-understanding\",\\n        \"connect-back\",\\n        \"connect-forward\",\\n        \"define\",\\n        \"demonstrate\",\\n        \"derive\",\\n        \"diagnose-misconception\",\\n        \"emphasise\",\\n        \"explain-cause\",\\n        \"interpret\",\\n        \"memory-aid\",\\n        \"name-parts\",\\n        \"orient\",\\n        \"practise-guided\",\\n        \"practise-independent\",\\n        \"sequence\",\\n        