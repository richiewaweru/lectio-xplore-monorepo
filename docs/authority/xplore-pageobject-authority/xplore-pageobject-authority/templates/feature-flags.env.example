# Creation controls. Reading persisted v2 documents must not depend on the
# creation flag once the v2 renderer ships.
XPLORE_PAGE_DOCUMENTS_ENABLED=false
XPLORE_PAGE_DOCUMENT_SCOPE=conceptual_first_exposure
XPLORE_PAGE_WRITER_RETRIES=1
XPLORE_PAGE_SEQUENTIAL_PLANNING=true

# Paid tests are disabled unless explicitly enabled by a human-controlled run.
ALLOW_PAID_LLM_TESTS=0
