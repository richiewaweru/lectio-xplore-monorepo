 "list_items_review": [
  {
   "section": "orient",
   "node": "shared-node-d057556ea171afe6f65b",
   "items": [
    "**Water** reaches the plant through its **roots**, which take it in from the soil; the stem then carries it up to the leaves.",
    "**Carbon dioxide** reaches the leaves from the air around the plant, passing in through small **openings** in the leaf surface.",
    "**Light energy** reaches the leaves from the sun, and the leaves **absorb** it.",
    "A plant needs all three \u2014 water, carbon dioxide and light \u2014 and it fails to grow well when any one of them is missing."
   ]
  },
  {
   "section": "contrast",
   "node": "shared-node-4f2ac0bbd1093a40395b",
   "items": [
    "Start with **light energy** \u2014 is the leaf in a bright place, or is the plant somewhere dark?",
    "Then check **water** \u2014 is water reaching the leaf from the soil, or has the soil been dry for days?",
    "Then check **carbon dioxide** \u2014 can air reach the leaf openings, or is the leaf coated so air cannot get in?"
   ]
  }
 ],
