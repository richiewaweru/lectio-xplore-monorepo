          "display": {
            "label": "Area of a rectangle",
            "inputs": [
              "length",
              "width"
            ],
            "outputs": [
              "area"
            ]
          },
          "accessibility": {
            "description": "The area of a rectangle equals its length multiplied by its width."
          }
        },
        {
          "id": "shared-node-3147ef18c10edb684e89",
          "teaching_block_id": "b1",
          "kind": "paragraph",
          "display": {
            "text": "An 8 m by 3 m rectangle has an **area** of 8 × 3 = 24 square metres. Multiplying the length by the width gives the result in square metres."
          },
          "accessibility": {
            "description": "A worked example showing that an 8 metre by 3 metre rectangle has an area of 24 square metres."
          }
        }
