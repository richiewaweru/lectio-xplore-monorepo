    {
      "id": "shared-node-662591cfeeed5c8aadd7",
      "teaching_block_id": "b1",
      "kind": "callout",
      "tone": "note",
      "title": "Chlorophyll captures the light",
      "body": "**Chlorophyll absorbs light energy in plant cells, and photosynthesis stores that energy as chemical energy in glucose.**",
      "variant": "key_idea",
      "aside": "Water and carbon dioxide supply the atoms for that glucose, and oxygen leaves the plant as a gas.\n\nThe light is not kept as light. It is transferred into the sugar the plant builds, so the plant holds that energy in a chemical form it can use later."
    }
