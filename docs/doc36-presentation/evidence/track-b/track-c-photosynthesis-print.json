  "sections": [
    {
      "id": "photosynthesis-section",
      "title": "How plants make food",
      "blocks": [
        {
          "id": "shared-node-014f83d5587a2a572750",
          "object": "equation",
          "intent": "explain",
          "position": 0,
          "content": {
            "label": [
              {
                "type": "text",
                "value": "Word equation for photosynthesis"
              }
            ],
            "inputs": [
              [
                {
                  "type": "text",
                  "value": "light energy"
                }
              ],
              [
                {
                  "type": "text",
                  "value": "water"
                }
              ],
              [
                {
                  "type": "text",
                  "value": "carbon dioxide"
                }
              ]
            ],
            "condition": [
              {
                "type": "text",
                "value": "in the presence of chlorophyll"
              }
            ],
            "outputs": [
              [
                {
                  "type": "text",
                  "value": "glucose"
                }
              ],
              [
                {
                  "type": "text",
                  "value": "oxygen"
                }
              ]
            ]
          },
          "layout": {
            "placement": "spanning"
          }
        },
        {
          "id": "shared-node-662591cfeeed5c8aadd7",
          "object": "aside",
          "intent": "emphasise",
          "position": 1,
          "content": {
            "body": [
              {
                "type": "strong",
                "children": [
                  {
                    "type": "text",
                    "value": "Chlorophyll absorbs light energy in plant cells, and photosynthesis stores that energy as chemical energy in glucose."
                  }
                ]
              }
            ],
            "label": [
              {
                "type": "text",
                "value": "Chlorophyll captures the light"
              }
            ],
            "variant": "key_idea",
            "aside": [
              {
                "type": "text",
                "value": "Water and carbon dioxide supply the atoms for that glucose, and oxygen leaves the plant as a gas.\n\nThe light is not kept as light. It is transferred into the sugar the plant builds, so the plant holds that energy in a chemical form it can use later."
              }
            ]
          },
          "layout": {
            "placement": "spanning"
          }
        }
      ]
    }
  ]
}
