  "dependency_graph_notes": "Learn Builder (builder/routes.py) currently imports Print PDF export (generation.pdf_export.*) for preflight/export — the primary Learn→Print edge. planning/ and generation/ are mixed hubs: curriculum leaves (service/models/schedule/outcomes/shapes) sit beside print whole_lesson and page_objects/pdf_export, while learn owns component_lectio and units_*. contracts/ and resource_specs/ split cleanly at leaf files (lectio_page/candidates = PRINT; lectio/lesson_document/component_candidates = LEARN). v3_blueprint/execution/review and generation/v3_studio remain cross-domain seams hosting Print HTTP until extraction. core/ is platform except monolithic core/database/models.py. Frontend mirrors this: lib/builder+learn+workspace = LEARN; lib/studio+generation+styles+components/studio = PRINT; lib/components/units = CURRICULUM; auth/config/settings = PLATFORM→shared; components/api/stores/types need seam extraction. packages/lectio-learn → lectio-learn (R6); packages/lectio-page stays PRINT. No Print→Learn backend edges recorded at baseline.",
  "print_learn_edges": {
    "learn_to_print": [
      "builder/routes.py → generation.pdf_export"
    ],
    "print_to_learn": []
  },
  "baseline_commands": {
    "page_test": "pnpm --filter @lectio/page test",
    "page_check": "pnpm --filter @lectio/page check",
    "page_pdf_fixture": "pnpm --filter @lectio/page pdf:fixture",
    "learn_package_test": "pnpm --dir packages/lectio-learn test",
    "learn_package_build": "pnpm --dir packages/lectio-learn build",
    "domain_boundaries": "python tools/xplore-program/check_domain_boundaries.py",
    "backend_print": "uv run pytest tests/generation/test_page_object_writers.py tests/planning/test_page_block_planner.py tests/generation/test_pdf_export_service.py -q",
    "backend_learn": "uv run pytest tests/generation/test_component_lectio_lifecycle.py tests/routes/test_builder_lessons.py tests/routes/test_learn_releases.py tests/routes/test_learn_runtime.py -q",
    "frontend_builder": "pnpm --dir apps/textbook-agent/frontend exec vitest run src/lib/builder --reporter=dot",
    "_cwd_backend_pytest": "apps/textbook-agent/backend"
  }
