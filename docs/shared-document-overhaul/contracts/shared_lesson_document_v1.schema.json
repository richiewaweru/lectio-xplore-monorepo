{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SharedLessonDocumentV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "teaching_plan_id",
    "teaching_plan_revision",
    "teaching_plan_hash",
    "title",
    "sections",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "teaching_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "teaching_plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "teaching_plan_hash": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "provenance": {
      "type": "object"
    }
  }
}
