ag if important labels are not legible in print.\\n', 'type': 'text'}, {'source': {'data': '', 'media_type': 'image/jpeg', 'type': 'base64'}, 'type': 'image'}]}], 'model': 'claude-haiku-4-5-20251001', 'stream': False, 'system': [{'type': 'text', 'text': 'You are a strict but practical image quality reviewer for educational materials. Return only the requested verdict.', 'cache_control': {'type': 'ephemeral', 'ttl': '5m'}}], 'tool_choice': {'type': 'any'}, 'tools': [{'name': 'final_result', 'description': 'The final response which ends this conversation', 'input_schema': {'properties': {'verdict': {'enum': ['accept', 'flag', 'reject'], 'type': 'string'}, 'reasons': {'items': {'type': 'string'}, 'type': 'array'}, 'correction_hint': {'default': '', 'type': 'string'}}, 'required': ['verdict'], 'type': 'object'}, 'cache_control': {'type': 'ephemeral', 'ttl': '5m'}}]}}"}
