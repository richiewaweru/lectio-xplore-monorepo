        \"status\": \"permitted\",\\n        \"teaching_role\": \"Represent an ordered process\"\\n      },\\n      {\\n        \"choose_when\": \"Show levels, containment, arrangement, or relationships that are hard to infer from prose.\",\\n        \"exclusion_reason\": null,\\n        \"id\": \"show-structure\",\\n        \"not_when\": \"\",\\n        \"status\": \"permitted\",\\n        \"teaching_role\": \"Reveal spatial or hierarchical organization\"\\n      },\\n      {\\n        \"choose_when\": \"State what the learner should be able to explain, do, compare, or justify.\",\\n        \"exclusion_reason\": \"excluded\",\\n        \"id\": \"state-goal\",\\n        \"not_when\": \"\",\\n        \"status\": \"excluded\",\\n        \"teaching_role\": \"Clarify the expected learning outcome\"\\n      },\\n      {\\n        \"choose_when\": \"Restate the minimum complete model, not a list of disconnected facts.\",\\n        \"exclusion_reason\": null,\\n        \"id\": \"summarise\",\\n        \"not_when\": \"\",\\n        \"status\": \"permitted\",\\n        \"teaching_role\": \"Compress the lesson into essential relationships\"\\n      },\\n      {\\n        \"choose_when\": \"Something identifiable \\\\u2014 matter, energy, information, money, data \\\\u2014 enters, changes, moves, and leaves, and the learner must not lose track of it.\",\\n        \"exclusion_reason\": null,\\n        \"id\": \"trace-flow\",\\n        \"not_when\": \"{\\'sequence\\': \\'the steps are actions taken, not a substance being followed\\', \\'explain-cause\\': \\'the point is why it happens, not where it goes\\', \\'show-structure\\': \\'the arrangement is static and nothing travels through it\\'}\",\\n        \"status\": \"permitted\",\\n        \"teaching_role\": \"Follow matter, energy, information, or value\"\\n      },\\n      {\\n        \"choose_when\": \"Change surface features enough that learners must recognize the underlying structure.\",\\n        \"exclusion_reason\": \"e