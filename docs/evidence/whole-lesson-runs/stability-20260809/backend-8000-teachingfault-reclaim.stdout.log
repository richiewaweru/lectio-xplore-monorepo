\"interpret\",\\n        \"memory-aid\",\\n        \"name-parts\",\\n        \"practise-guided\",\\n        \"practise-independent\",\\n        \"sequence\",\\n        \"show-structure\",\\n        \"summarise\",\\n        \"trace-flow\",\\n        \"warn\"\\n      ],\\n      \"typical_intents\": [\\n        \"activate-prior-knowledge\",\\n        \"emphasise\",\\n        \"orient\"\\n      ]\\n    }\\n  },\\n  \"teaching_guidance\": {\\n    \"catalogue_version\": \"1.1.0\",\\n    \"intents\": [\\n      {\\n        \"choose_when\": \"Prompt recall of concepts required for this lesson. Keep it brief and diagnostic.\",\\n        \"exclusion_reason\": null,\\n        \"id\": \"activate-prior-knowledge\",\\n        \"not_when\": \"\",\\n        \"status\": \"permitted\",\\n        \"teaching_role\": \"Surface prerequisite knowledge\"\\n      },\\n      {\\n        \"choose_when\": \"Require selection and use of the learned idea in a recognizable context.\",\\n        \"exclusion_reason\": null,\\n        \"id\": \"apply\",\\n        \"not_when\": \"\",\\n        \"status\": \"permitted\",\\n        \"teaching_role\": \"Use knowledge in a familiar situation\"\\n      },\\n      {\\n        \"choose_when\": \"The teacher needs to know right now whether the objective landed, and correct-versus-incorrect is the signal being read.\",\\n        \"exclusion_reason\": null,\\n        \"id\": \"check-understanding\",\\n        \"not_when\": \"{\\'diagnose-misconception\\': \\'wrong answers must identify WHICH wrong model the learner holds\\', \\'practise-independent\\': \\'the purpose is rehearsal rather than measurement\\', \\'reflect\\': \\'there is no correct answer\\'}\",\\n        \"status\": \"permitted\",\\n        \"teaching_role\": \"Detect immediate misunderstanding\"\\n      },\\n      {\\n        \"choose_when\": \"Provide or elicit a rule for category membership and contrast borderline cases.\",\\n        \"exclusion_reason\": null,\\n        \"id\": \"classify\",\\