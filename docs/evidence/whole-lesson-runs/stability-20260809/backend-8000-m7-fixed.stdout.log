: \"model-b1\",\\n    \"intent\": \"show-structure\",\\n    \"object\": \"figure\",\\n    \"placement\": \"main\",\\n    \"position\": 0\\n  },\\n  \"lesson_context\": {\\n    \"anchor\": {\\n      \"description\": \"A puddle on a playground after a rainstorm, slowly disappearing over sunny days, then reappearing a\\\\u2026\",\\n      \"id\": \"anchor-1\"\\n    },\\n    \"grade_level\": \"Grade 6\",\\n    \"must_not_introduce\": [\\n      \"transpiration\",\\n      \"sublimation\",\\n      \"groundwater flow\",\\n      \"water table\",\\n      \"detailed cloud formation beyond condensation\",\\n      \"atmospheric layers\"\\n    ],\\n    \"objective\": \"Draw a clear labelled diagram of the water cycle showing evaporation, condensation, precipitation, collection, and the movement of water, and describe the cycle using the diagram\",\\n    \"subject\": \"Science\"\\n  },\\n  \"neighbours\": {\\n    \"after\": \"Using the completed diagram, trace the flow: \\'The Sun\\'s energy causes evaporation from the ocean; water vapor rises and condenses into clouds (condensation); clouds release precipitation; water collects in the ocean again. The cycle repeats continuously \\\\u2014 it is not one-way.\\' Connect back to the puddle: puddle water evaporates, condenses into clouds, falls as rain, and re-fills the puddle. Emphasize the circular nature to pre-empt M2.\",\\n    \"before\": \"\"\\n  },\\n  \"section_context\": {\\n    \"section_id\": \"model\"\\n  },\\n  \"terminology\": [\\n    \"evaporation\",\\n    \"condensation\",\\n    \"precipitation\",\\n    \"collection\",\\n    \"water cycle\",\\n    \"water vapor\"\\n  ],\\n  \"writer_contract\": {\\n    \"capacity\": {\\n      \"altTextMaxWords\": 40,\\n      \"captionMaxWords\": 30\\n    },\\n    \"catalogue_version\": \"1.1.0\",\\n    \"content_schema\": {\\n      \"alt_text\": \"string\",\\n      \"asset\": \"FigureAsset\",\\n      \"caption\": \"string|null\",\\n      \"width\": \"main|span\"\\n    },\\n    \"failure