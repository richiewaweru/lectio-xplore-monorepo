{"timestamp": "2026-08-11T15:40:35.420926+00:00", "level": "DEBUG", "logger": "openai._base_client", "message": "HTTP Response: POST https://api.deepseek.com/chat/completions \"200 OK\" Headers({'content-type': 'application/json', 'transfer-encoding': 'chunked', 'connection': 'keep-alive', 'date': 'Tue, 11 Aug 2026 15:37:44 GMT', 'server': 'elb', 'content-encoding': 'gzip', 'vary': 'origin, access-control-request-method, access-control-request-headers', 'access-control-allow-credentials': 'true', 'x-ds-trace-id': '7022ebac1a49ccbb1cb50d1532cae8b0', 'strict-transport-security': 'max-age=31536000; includeSubDomains; preload', 'x-content-type-options': 'nosniff', 'x-cache': 'Miss from cloudfront', 'via': '1.1 3439487755047758308c2b5cc2f68a2a.cloudfront.net (CloudFront)', 'x-amz-cf-pop': 'NBO50-P2', 'x-amz-cf-id': 'Ed_p0sO6Y3DOimQFi7sYYeXQdPRWUCBmKJCVuMAMAnbMk4ttCIf5Pg=='})"}
