idth\\\\\": \\\\\"main\\\\\",\\\\n  \\\\\"asset\\\\\": {\\\\n    \\\\\"type\\\\\": \\\\\"svg\\\\\",\\\\n    \\\\\"data\\\\\": \\\\\"<svg xmlns=\\'http://www.w3.org/2000/svg\\' viewBox=\\'0 0 800 600\\' font-family=\\'Arial, sans-serif\\'><rect width=\\'800\\' height=\\'600\\' fill=\\'white\\'/><circle cx=\\'700\\' cy=\\'70\\' r=\\'35\\' fill=\\'#FFD700\\' stroke=\\'#FF8C00\\' stroke-width=\\'3\\'/><text x=\\'700\\' y=\\'125\\' text-anchor=\\'middle\\' font-size=\\'16\\' font-weight=\\'bold\\'>Sun\\'s energy</text><rect x=\\'50\\' y=\\'480\\' width=\\'700\\' height=\\'80\\' fill=\\'#4FC3F7\\' stroke=\\'#0288D1\\' stroke-width=\\'3\\'/><text x=\\'400\\' y=\\'530\\' text-anchor=\\'middle\\' font-size=\\'18\\' font-weight=\\'bold\\' fill=\\'#000\\'>Collection (ocean/lake)</text><defs><marker id=\\'arrowhead\\' markerWidth=\\'10\\' markerHeight=\\'7\\' refX=\\'10\\' refY=\\'3.5\\' orient=\\'auto\\'><polygon points=\\'0 0, 10 3.5, 0 7\\' fill=\\'#000\\'/></marker></defs><line x1=\\'250\\' y1=\\'480\\' x2=\\'250\\' y2=\\'280\\' stroke=\\'#000\\' stroke-width=\\'3\\' marker-end=\\'url(#arrowhead)\\'/><line x1=\\'400\\' y1=\\'480\\' x2=\\'400\\' y2=\\'280\\' stroke=\\'#000\\' stroke-width=\\'3\\' marker-end=\\'url(#arrowhead)\\'/><text x=\\'330\\' y=\\'380\\' text-anchor=\\'middle\\' font-size=\\'16\\' font-weight=\\'bold\\'>Evaporation (water vapor)</text><text x=\\'330\\' y=\\'405\\' text-anchor=\\'middle\\' font-size=\\'13\\' fill=\\'#555\\'>(invisible gas)</text><ellipse cx=\\'250\\' cy=\\'180\\' rx=\\'70\\' ry=\\'35\\' fill=\\'#E0E0E0\\' stroke=\\'#9E9E9E\\' stroke-width=\\'2\\'/><ellipse cx=\\'350\\' cy=\\'160\\' rx=\\'80\\' ry=\\'45\\' fill=\\'#E0E0E0\\' stroke=\\'#9E9E9E\\' stroke-width=\\'2\\'/><ellipse cx=\\'450\\' cy=\\'180\\' rx=\\'70\\' ry=\\'35\\' fill=\\'#E0E0E0\\' stroke=\\'#9E9E9E\\' stroke-width=\\'2\\'/><text x=\\'350\\' y=\\'230\\' text-anchor=\\'middle\\' font-size=\\'17\\' font-weight=\\'bold\\'>Condensation (clouds)</text><text x=\\'350\\' y=\\'255\\' text-anchor=\\'middle\\' font-size=\\'13\\' fill=\\'#555\\'>(tiny liquid water droplets)</text><line x1=\\'300\\' y1=\\'215\\' x2=\\'300\\' y2=\\'450\\' stroke=\\'#000\\' stroke-width=\\'2\\' stroke-dasharray=\\'8,5\\' marker-end=\\'url(#arrowhead)\\'/><line x1=\\'400\\' y1=\\'205\\' x2=\\'400\\' y2=\\'450\\' stroke=\\'#000\\' stroke-width=\\'2\\' stroke-dasharray=\\'8,5\\' marker-end=\\'url(#arrowhead)\\'/><line x1=\\'500\\' y1=\\'215\\' x2=\\'500\\' y2=\\'450\\' stroke=\\'#000\\' stroke-width=\\'2\\' stroke-dasharray=\\'8,5\\' marker-end=\\'url(#arrowhead)\\'/><text x=\\'560\\' y=\\'330\\' text-anchor=\\'middle\\' font-size=\\'16\\' font-weight=\\'bold\\'>Precipitation (rain, etc.)</text><rect x=\\'620\\' y=\\'460\\' width=\\'120\\' height=\\'20\\' fill=\\'#8D6E63\\' stroke=\\'#5D4037\\' stroke-width=\\'2\\'/><line x1=\\'680\\' y1=\\'460\\' x2=\\'550\\' y2=\\'490\\' stroke=\\'#000\\' stroke-width=\\'3\\' marker-end=\\'url(#arrowhead)\\'/><text x=\\'700\\' y=\\'500\\' text-anchor=\\'middle\\' font-size=\\'16\\' font-weight=\\'bold\\'>Collection</text></svg>\\\\\"\\\\n  }\\\\n}\",\\n  \"requested_object\": \"figure\",\\n  \"validation_errors\": [\\n    {\\n      \"message\": \"Extra inputs are not permitted\",\\n      \"path\": \"asset.type\"\\n    },\\n    {\\n      \"message\": \"Extra inputs are not permitted\",\\n      \"path\": \"asset.data\"\\n    }\\n  ],\\n  \"writer_contract\": {\\n    \"capacity\": {\\n      \"altTextMaxWords\": 40,\\n      \"captionMaxWords\": 30\\n    },\\n    \"catalogue_version\": \"1.1.0\",\\n    \"content_schema\": {\\n      \"alt_text\": \"string\",\\n      \"asset\": \"FigureAsset\",\\n      \"caption\": \"string|null\",\\n      \"width\": \"main|span\"\\n    },\\n    \"failure_examples\": [],\\n    \"generation_guidance\": \"\",\\n    \"object_id\": \"figure\",\\n    \"object_validation\": []\\n  }\\n}'}, {'role': 'user', 'content': \"Return JSON only for this block's content schema.\"}], 'model': 'deepseek-v4-flash', 'max_complet